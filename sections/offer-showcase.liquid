{%- style -%}
  .offer-showcase-{{ section.id }} {
    --offer-showcase-background: {{ section.settings.background }};
    --offer-showcase-text: {{ section.settings.text_color }};
    --offer-showcase-border: {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .offer-showcase-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="offer-showcase offer-showcase-{{ section.id }}" aria-label="{{ section.settings.accessible_label | escape }}">
  <div class="offer-showcase__inner page-width">
    <div class="offer-showcase__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'offer' -%}
            {%- if block.settings.link != blank -%}
              <a class="offer-showcase__offer offer-showcase__offer--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="offer-showcase__offer" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- if block.settings.offer_label != blank -%}
                <p class="offer-showcase__label">{{ block.settings.offer_label | escape }}</p>
              {%- endif -%}
              <div class="offer-showcase__value">
                <span class="offer-showcase__amount">{{ block.settings.offer_value | escape }}</span>
                {%- if block.settings.offer_suffix != blank -%}
                  <span class="offer-showcase__suffix">{{ block.settings.offer_suffix | escape }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.offer_text != blank -%}
                <p class="offer-showcase__text">{{ block.settings.offer_text | escape | newline_to_br }}</p>
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- when 'image' -%}
            <div class="offer-showcase__image" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="offer-showcase__image-link">{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      widths: '180, 360, 540, 720, 900',
                      sizes: '(min-width: 990px) 12vw, (min-width: 750px) 18vw, 44vw',
                      loading: 'lazy',
                      class: 'offer-showcase__image-media'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg offer-showcase__image-media' }}
                {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .offer-showcase {
    background: var(--offer-showcase-background);
    color: var(--offer-showcase-text);
  }

  .offer-showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .offer-showcase__offer,
  .offer-showcase__image {
    min-height: 18rem;
  }

  .offer-showcase__offer {
    align-items: center;
    border: 0.1rem solid var(--offer-showcase-border);
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.4rem 1.6rem;
    text-align: center;
    text-decoration: none;
  }

  .offer-showcase__offer--link {
    transition: background-color 150ms ease, color 150ms ease;
  }

  .offer-showcase__offer--link:hover,
  .offer-showcase__offer--link:focus-visible {
    background: var(--offer-showcase-text);
    color: var(--offer-showcase-background);
  }

  .offer-showcase__label,
  .offer-showcase__text {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.38rem;
    line-height: 1.35;
    margin: 0;
    text-transform: uppercase;
  }

  .offer-showcase__value {
    align-items: flex-start;
    display: flex;
    line-height: 0.8;
    margin: 1.2rem 0 1.5rem;
  }

  .offer-showcase__amount {
    font-family: var(--font-heading-family);
    font-size: clamp(5.6rem, 9vw, 9rem);
    letter-spacing: -0.06em;
  }

  .offer-showcase__suffix {
    font-size: 1.1rem;
    letter-spacing: 0.18rem;
    margin: 0.8rem 0 0 0.4rem;
    text-transform: uppercase;
  }

  .offer-showcase__image,
  .offer-showcase__image-link {
    display: block;
    overflow: hidden;
  }

  .offer-showcase__image-media {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
    width: 100%;
  }

  .offer-showcase__image-link:hover .offer-showcase__image-media,
  .offer-showcase__image-link:focus-visible .offer-showcase__image-media {
    transform: scale(1.04);
  }

  @media screen and (min-width: 750px) {
    .offer-showcase__grid {
      grid-template-columns: minmax(15rem, 1.4fr) repeat(2, minmax(10rem, 0.9fr)) minmax(15rem, 1.4fr) repeat(2, minmax(10rem, 0.9fr));
      gap: 2.4rem;
    }

    .offer-showcase__offer,
    .offer-showcase__image {
      min-height: 21.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Offer showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Promotional offers"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#f0e9de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3b1d14"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#3b1d14"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer card",
      "settings": [
        {
          "type": "text",
          "id": "offer_label",
          "label": "Top text",
          "default": "Enjoy"
        },
        {
          "type": "text",
          "id": "offer_value",
          "label": "Offer value",
          "default": "15"
        },
        {
          "type": "text",
          "id": "offer_suffix",
          "label": "Offer suffix",
          "default": "% off"
        },
        {
          "type": "textarea",
          "id": "offer_text",
          "label": "Offer text",
          "default": "On your first purchase"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Promotional image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer showcase",
      "blocks": [
        { "type": "offer" },
        { "type": "image" },
        { "type": "image" },
        { "type": "offer" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
