{% comment %}
  Section: SH - Editorial Journal Grid
  Description: High-fashion editorial journal/stories grid inspired by modern luxury publications.
  Features:
  - Bold + Italic serif dual heading ("From The Journal — Stories & Style")
  - Large responsive cards with aspect-ratio control & smooth hover zoom
  - Elegant meta bar with author, hairline divider rule, and date
  - Supports dynamic Shopify Blog OR fully customizable manual story blocks
  - 100% responsive (desktop grid, tablet, mobile stack or swipe)
  - Full theme editor customization (colors, fonts, sizes, gaps, paddings)
{% endcomment %}

{%- liquid
  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
  endif
-%}

{%- style -%}
  #sh-journal-{{ section.id }} {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' and section.settings.bg_color != 'transparent' %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #sh-journal-{{ section.id }} .sh-journal-container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.max_width }}px;
      padding-left: 20px;
      padding-right: 20px;
    {% else %}
      padding-left: 24px;
      padding-right: 24px;
    {% endunless %}
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} .sh-journal-container {
      {% unless section.settings.full_width %}
        padding-left: 40px;
        padding-right: 40px;
      {% else %}
        padding-left: 48px;
        padding-right: 48px;
      {% endunless %}
    }
  }

  /* Header */
  #sh-journal-{{ section.id }} .sh-journal-header {
    display: flex;
    align-items: baseline;
    justify-content: {% if section.settings.heading_alignment == 'center' %}center{% else %}space-between{% endif %};
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-bottom: {{ section.settings.header_margin_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} .sh-journal-header {
      margin-bottom: {{ section.settings.header_margin_bottom }}px;
    }
  }

  #sh-journal-{{ section.id }} .sh-journal-title {
    margin: 0;
    line-height: 1.2;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35em 0.5em;
    text-align: {{ section.settings.heading_alignment }};
  }

  #sh-journal-{{ section.id }} .sh-journal-title__main {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: {{ section.settings.heading_color }};
  }

  #sh-journal-{{ section.id }} .sh-journal-title__sep {
    font-weight: 300;
    color: {{ section.settings.subheading_color }};
    opacity: 0.8;
  }

  #sh-journal-{{ section.id }} .sh-journal-title__accent {
    font-family: Georgia, "Times New Roman", var(--font-heading-family), serif;
    font-style: italic;
    font-weight: 400;
    font-size: {{ section.settings.heading_size_mobile | times: 0.98 | round: 0 }}px;
    letter-spacing: -0.01em;
    color: {{ section.settings.subheading_color }};
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} .sh-journal-title__main {
      font-size: {{ section.settings.heading_size }}px;
    }

    #sh-journal-{{ section.id }} .sh-journal-title__accent {
      font-size: {{ section.settings.heading_size | times: 0.96 | round: 0 }}px;
    }
  }

  #sh-journal-{{ section.id }} .sh-journal-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    text-decoration: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #sh-journal-{{ section.id }} .sh-journal-view-all:hover {
    opacity: 0.7;
    transform: translateX(3px);
  }

  /* Grid Layout */
  #sh-journal-{{ section.id }} .sh-journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} .sh-journal-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.card_gap }}px;
    }
  }

  /* Mobile Swipe Option */
  {% if section.settings.mobile_layout == 'swipe' %}
    @media screen and (max-width: 749px) {
      #sh-journal-{{ section.id }} .sh-journal-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        gap: 18px;
        padding-bottom: 16px;
        margin-left: -20px;
        margin-right: -20px;
        padding-left: 20px;
        padding-right: 20px;
        scrollbar-width: none;
      }
      #sh-journal-{{ section.id }} .sh-journal-grid::-webkit-scrollbar {
        display: none;
      }
      #sh-journal-{{ section.id }} .sh-journal-card {
        flex: 0 0 85%;
        scroll-snap-align: start;
      }
    }
  {% endif %}

  /* Card */
  #sh-journal-{{ section.id }} .sh-journal-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  /* Image Media */
  #sh-journal-{{ section.id }} .sh-journal-card__media-link {
    display: block;
    width: 100%;
    text-decoration: none;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #sh-journal-{{ section.id }} .sh-journal-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f1f1f1;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #sh-journal-{{ section.id }} .sh-journal-ratio--16-9 {
    aspect-ratio: 16 / 9;
  }

  #sh-journal-{{ section.id }} .sh-journal-ratio--3-2 {
    aspect-ratio: 3 / 2;
  }

  #sh-journal-{{ section.id }} .sh-journal-ratio--4-3 {
    aspect-ratio: 4 / 3;
  }

  #sh-journal-{{ section.id }} .sh-journal-ratio--1-1 {
    aspect-ratio: 1 / 1;
  }

  #sh-journal-{{ section.id }} .sh-journal-ratio--auto {
    aspect-ratio: auto;
    min-height: 280px;
  }

  #sh-journal-{{ section.id }} .sh-journal-card__media img,
  #sh-journal-{{ section.id }} .sh-journal-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    {% if section.settings.enable_image_zoom %}
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    {% endif %}
  }

  {% if section.settings.enable_image_zoom %}
    #sh-journal-{{ section.id }} .sh-journal-card:hover .sh-journal-card__media img {
      transform: scale(1.045);
    }
  {% endif %}

  /* Meta Bar (Author ────── Date) */
  #sh-journal-{{ section.id }} .sh-journal-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
    margin-bottom: 12px;
    box-sizing: border-box;
    width: 100%;
  }

  #sh-journal-{{ section.id }} .sh-journal-card__author {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.meta_color }};
    white-space: nowrap;
    flex-shrink: 0;
  }

  #sh-journal-{{ section.id }} .sh-journal-card__line {
    flex: 1;
    height: 1px;
    background-color: {{ section.settings.line_color }};
    min-width: 16px;
    display: block;
  }

  #sh-journal-{{ section.id }} .sh-journal-card__date {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.meta_color }};
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Story Title */
  #sh-journal-{{ section.id }} .sh-journal-card__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: {{ section.settings.title_color }};
  }

  @media screen and (min-width: 750px) {
    #sh-journal-{{ section.id }} .sh-journal-card__title {
      font-size: {{ section.settings.title_size }}px;
    }
  }

  #sh-journal-{{ section.id }} .sh-journal-card__title-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0% 100%;
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    transition: background-size 0.35s ease, color 0.25s ease;
  }

  #sh-journal-{{ section.id }} .sh-journal-card:hover .sh-journal-card__title-link {
    background-size: 100% 1.5px;
    {% if section.settings.title_hover_color != blank and section.settings.title_hover_color != 'rgba(0,0,0,0)' %}
      color: {{ section.settings.title_hover_color }};
    {% endif %}
  }

  /* Optional Excerpt */
  #sh-journal-{{ section.id }} .sh-journal-card__excerpt {
    margin-top: 10px;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.meta_color }};
    opacity: 0.9;
  }
{%- endstyle -%}

<section
  id="sh-journal-{{ section.id }}"
  class="sh-journal-section color-{{ section.settings.color_scheme }} gradient"
  {{ section.shopify_attributes }}
>
  <div class="sh-journal-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="sh-journal-header">
        <h2 class="sh-journal-title">
          {%- if section.settings.heading != blank -%}
            <span class="sh-journal-title__main">{{ section.settings.heading }}</span>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <span class="sh-journal-title__sep">—</span>
            <span class="sh-journal-title__accent">{{ section.settings.subheading }}</span>
          {%- endif -%}
        </h2>

        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="sh-journal-view-all">
            {{ section.settings.view_all_text | default: 'View all stories' }}
            <span>&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sh-journal-grid" role="list">
      {%- if use_blocks -%}
        {%- for block in section.blocks -%}
          <article class="sh-journal-card" {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="sh-journal-card__media-link"
              aria-label="{{ block.settings.title | escape }}"
            >
              <div class="sh-journal-card__media sh-journal-ratio--{{ section.settings.image_aspect_ratio }}">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 1000, 1400',
                      alt: block.settings.title,
                      class: 'sh-journal-img'
                  }}
                {%- else -%}
                  {%- assign placeholder_idx = forloop.index0 | modulo: 3 | plus: 1 -%}
                  {{ 'collection-apparel-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </a>

            <div class="sh-journal-card__meta">
              {%- if section.settings.show_author and block.settings.author != blank -%}
                <span class="sh-journal-card__author">{{ block.settings.author }}</span>
              {%- endif -%}

              {%- if section.settings.show_meta_line -%}
                <span class="sh-journal-card__line"></span>
              {%- endif -%}

              {%- if section.settings.show_date and block.settings.date != blank -%}
                <span class="sh-journal-card__date">{{ block.settings.date }}</span>
              {%- endif -%}
            </div>

            <h3 class="sh-journal-card__title">
              <a href="{{ block.settings.link | default: '#' }}" class="sh-journal-card__title-link">
                {{ block.settings.title }}
              </a>
            </h3>

            {%- if section.settings.show_excerpt and block.settings.excerpt != blank -%}
              <div class="sh-journal-card__excerpt">
                {{ block.settings.excerpt }}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}

      {%- elsif section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <article class="sh-journal-card">
            <a
              href="{{ article.url }}"
              class="sh-journal-card__media-link"
              aria-label="{{ article.title | escape }}"
            >
              <div class="sh-journal-card__media sh-journal-ratio--{{ section.settings.image_aspect_ratio }}">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 1000, 1400',
                      alt: article.title,
                      class: 'sh-journal-img'
                  }}
                {%- else -%}
                  {%- assign placeholder_idx = forloop.index0 | modulo: 3 | plus: 1 -%}
                  {{ 'blog-apparel-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </a>

            <div class="sh-journal-card__meta">
              {%- if section.settings.show_author -%}
                <span class="sh-journal-card__author">{{ article.author | default: shop.name }}</span>
              {%- endif -%}

              {%- if section.settings.show_meta_line -%}
                <span class="sh-journal-card__line"></span>
              {%- endif -%}

              {%- if section.settings.show_date -%}
                <span class="sh-journal-card__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
              {%- endif -%}
            </div>

            <h3 class="sh-journal-card__title">
              <a href="{{ article.url }}" class="sh-journal-card__title-link">
                {{ article.title }}
              </a>
            </h3>

            {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
              <div class="sh-journal-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}

      {%- else -%}
        {% comment %} Default Editorial Demo Cards {% endcomment %}
        <article class="sh-journal-card">
          <a href="#" class="sh-journal-card__media-link" aria-label="Build a timeless and enduring capsule wardrobe">
            <div class="sh-journal-card__media sh-journal-ratio--{{ section.settings.image_aspect_ratio }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </a>
          <div class="sh-journal-card__meta">
            <span class="sh-journal-card__author">REZA KHAN</span>
            <span class="sh-journal-card__line"></span>
            <span class="sh-journal-card__date">JANUARY 1, 2026</span>
          </div>
          <h3 class="sh-journal-card__title">
            <a href="#" class="sh-journal-card__title-link">
              Build a timeless and enduring capsule wardrobe
            </a>
          </h3>
        </article>

        <article class="sh-journal-card">
          <a href="#" class="sh-journal-card__media-link" aria-label="Adopt the new rules of minimal style today.">
            <div class="sh-journal-card__media sh-journal-ratio--{{ section.settings.image_aspect_ratio }}">
              {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </a>
          <div class="sh-journal-card__meta">
            <span class="sh-journal-card__author">REZA KHAN</span>
            <span class="sh-journal-card__line"></span>
            <span class="sh-journal-card__date">JANUARY 1, 2026</span>
          </div>
          <h3 class="sh-journal-card__title">
            <a href="#" class="sh-journal-card__title-link">
              Adopt the new rules of minimal style today.
            </a>
          </h3>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SH - Editorial Journal",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Main",
      "default": "From The Journal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Heading Accent (Italic)",
      "default": "Stories & Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Desktop Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Heading Mobile Size",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Header Bottom Margin",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View all stories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Blog Feed (Optional)"
    },
    {
      "type": "paragraph",
      "content": "Select a Blog to display live articles automatically, or add Story Blocks below for full manual curation."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Articles to Show",
      "default": 2
    },
    {
      "type": "header",
      "content": "Grid & Card Design"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 16,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Card Gap",
      "default": 32
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "16-9", "label": "Landscape (16:9)" },
        { "value": "3-2", "label": "Classic (3:2)" },
        { "value": "4-3", "label": "Standard (4:3)" },
        { "value": "1-1", "label": "Square (1:1)" },
        { "value": "auto", "label": "Natural" }
      ],
      "default": "16-9"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable Image Hover Zoom",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        { "value": "stack", "label": "Vertical Stack" },
        { "value": "swipe", "label": "Horizontal Swipe" }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "Card Metadata"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta_line",
      "label": "Show Dividing Hairline Rule",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": false
    },
    {
      "type": "header",
      "content": "Card Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 11,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Title Desktop Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 11,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Title Mobile Size",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Main Heading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Italic Subheading Color",
      "default": "#121212"
    },
    {
