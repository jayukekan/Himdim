{%- capture sh_upcoming_showcase_css -%}
<style>
  #sh-showcase-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-container {
    max-width: {{ section.settings.section_max_width }}px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  /* Header */
  #sh-showcase-{{ section.id }} .sh-showcase-header {
    margin-bottom: 30px;
    text-align: {{ section.settings.heading_alignment }};
  }

  #sh-showcase-{{ section.id }} .sh-showcase-heading {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-heading-main {
    font-family: var(--font-heading-family);
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-heading-suffix {
    font-family: {% if section.settings.side_list_font_style == 'serif' %}Georgia, "Times New Roman", serif{% elsif section.settings.side_list_font_style == 'sans-serif' %}sans-serif{% else %}var(--font-heading-family){% endif %};
    font-style: italic;
    font-weight: 400;
    opacity: 0.9;
  }

  /* Main Stage Layout */
  #sh-showcase-{{ section.id }} .sh-showcase-stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: calc({{ section.settings.capsule_height_desktop }}px + {{ section.settings.image_popout_desktop }}px);
    padding-top: {{ section.settings.image_popout_desktop | plus: 20 }}px;
  }

  /* Central Capsule Pill */
  #sh-showcase-{{ section.id }} .sh-showcase-capsule {
    width: {{ section.settings.capsule_width }}%;
    max-width: 960px;
    height: {{ section.settings.capsule_height_desktop }}px;
    border-radius: {{ section.settings.capsule_border_radius }}px;
    position: relative;
    overflow: visible;
    transition: background-color 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  /* Slides */
  #sh-showcase-{{ section.id }} .sh-showcase-slides {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-slide {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96) translateY(8px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.55s ease;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
    text-decoration: none;
    overflow: visible;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateY(0);
    z-index: 2;
    pointer-events: auto;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
    overflow: visible;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-media img {
    max-width: {{ section.settings.image_max_width }}%;
    width: auto;
    height: calc(100% + {{ section.settings.image_popout_desktop }}px);
    max-height: calc(100% + {{ section.settings.image_popout_desktop }}px);
    object-fit: contain;
    object-position: bottom center;
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    z-index: 3;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-media svg {
    width: 60%;
    height: 60%;
    margin-bottom: 40px;
    opacity: 0.5;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-slide-btn {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    color: #111111;
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    z-index: 4;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-slide-btn:hover {
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }

  /* Navigation Arrows */
  #sh-showcase-{{ section.id }} .sh-showcase-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  #sh-showcase-{{ section.id }} .sh-showcase-arrow:hover {
    transform: translateY(-50%) scale(1.08);
  }

  #sh-showcase-{{ section.id }} .sh-showcase-arrow-prev {
    left: 4%;
    background-color: #f0f0f0;
    color: #666666;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-arrow-prev svg {
    fill: currentColor;
    width: 16px;
    height: 16px;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-arrow-next {
    right: 4%;
    background-color: #111111;
    color: #ffffff;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-arrow-next svg {
    fill: currentColor;
    width: 16px;
    height: 16px;
  }

  /* Side Category/Product List */
  #sh-showcase-{{ section.id }} .sh-showcase-side-list {
    position: absolute;
    right: 3%;
    bottom: 12%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    z-index:1;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-side-item {
    background: none;
    border: none;
    padding: 2px 0;
    font-family: {% if section.settings.side_list_font_style == 'serif' %}Georgia, "Times New Roman", serif{% elsif section.settings.side_list_font_style == 'sans-serif' %}sans-serif{% else %}var(--font-heading-family){% endif %};
    font-size: {{ section.settings.side_list_font_size }}px;
    line-height: 1.25;
    color: #111111;
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
    text-align: left;
    white-space: nowrap;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-side-item:hover {
    opacity: 0.75;
    transform: translateX(3px);
  }

  #sh-showcase-{{ section.id }} .sh-showcase-side-item.is-active {
    opacity: 1;
    font-weight: 600;
    transform: translateX(0);
  }

  /* Pagination Dots */
  #sh-showcase-{{ section.id }} .sh-showcase-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    position: relative;
    z-index: 5;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #dcdcdc;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  #sh-showcase-{{ section.id }} .sh-showcase-dot.is-active {
    background-color: #111111;
    transform: scale(1.2);
  }

  /* Responsive Adjustments */
  @media only screen and (max-width: 989px) {
    #sh-showcase-{{ section.id }} .sh-showcase-capsule {
      width: 88%;
      height: 400px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-side-list {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
      margin-top: 20px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-side-item {
      font-size: 20px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-arrow-prev {
      left: 1%;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-arrow-next {
      right: 1%;
    }
  }

  @media only screen and (max-width: 767px) {
    #sh-showcase-{{ section.id }} {
      padding-top: {{ section.settings.mob_padding_top }}px;
      padding-bottom: {{ section.settings.mob_padding_bottom }}px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-container {
      padding: 0 16px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-heading {
      font-size: {{ section.settings.mob_heading_size }}px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-stage {
      min-height: calc({{ section.settings.capsule_height_mobile }}px + {{ section.settings.image_popout_mobile }}px);
      padding-top: {{ section.settings.image_popout_mobile | plus: 15 }}px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-capsule {
      width: 92%;
      height: {{ section.settings.capsule_height_mobile }}px;
      border-radius: calc({{ section.settings.capsule_border_radius }}px * 0.7);
    }

    #sh-showcase-{{ section.id }} .sh-showcase-media img {
      height: calc(100% + {{ section.settings.image_popout_mobile }}px);
      max-height: calc(100% + {{ section.settings.image_popout_mobile }}px);
      max-width: 94%;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-arrow {
      width: 38px;
      height: 38px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-arrow-prev svg,
    #sh-showcase-{{ section.id }} .sh-showcase-arrow-next svg {
      width: 13px;
      height: 13px;
    }

    #sh-showcase-{{ section.id }} .sh-showcase-side-item {
      font-size: 18px;
    }
  }
</style>
{%- endcapture -%}
{{- sh_upcoming_showcase_css | strip_newlines -}}

<div id="sh-showcase-{{ section.id }}" class="sh-upcoming-showcase-section">
  <div class="sh-showcase-container">
    
    <!-- Section Heading -->
    {% if section.settings.heading_main != blank or section.settings.heading_suffix != blank %}
      <div class="sh-showcase-header">
        <h2 class="sh-showcase-heading">
          {% if section.settings.heading_main != blank %}
            <span class="sh-showcase-heading-main">{{ section.settings.heading_main }}</span>
          {% endif %}
          {% if section.settings.heading_suffix != blank %}
            <span class="sh-showcase-heading-suffix">{{ section.settings.heading_suffix }}</span>
          {% endif %}
        </h2>
      </div>
    {% endif %}

    <!-- Interactive Showcase Stage -->
    <div class="sh-showcase-stage" data-sh-showcase>
      
      <!-- Prev Arrow -->
      {% if section.settings.show_arrows %}
        <button type="button" class="sh-showcase-arrow sh-showcase-arrow-prev" aria-label="Previous Slide">
          {% render 'sh-arrows', arrow: 'prev' %}
        </button>
      {% endif %}

      <!-- Center Capsule Pill -->
      <div class="sh-showcase-capsule" data-sh-capsule style="background-color: {{ section.blocks.first.settings.pill_bg_color | default: section.settings.default_capsule_bg }};">
        <div class="sh-showcase-slides">
          {% for block in section.blocks %}
            {% liquid
              assign item_product = block.settings.product
              assign item_title = block.settings.title
              if item_title == blank and item_product != blank
                assign item_title = item_product.title
              elsif item_title == blank
                assign item_title = 'Collection ' | append: forloop.index
              endif

              assign item_link = block.settings.link
              if item_link == blank and item_product != blank
                assign item_link = item_product.url
              endif

              assign item_image = block.settings.image
              if item_image == blank and item_product != blank
                assign item_image = item_product.featured_image
              endif

              assign item_bg = block.settings.pill_bg_color
              if item_bg == blank
                assign item_bg = section.settings.default_capsule_bg
              endif
            %}

            <div
              class="sh-showcase-slide{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              data-bg="{{ item_bg }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="sh-showcase-media">
                {% if item_image != blank %}
                  {{ item_image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    alt: item_title,
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(max-width: 767px) 90vw, 800px'
                  }}
                {% else %}
                  {% assign svg_index = forloop.index | modulo: 6 | plus: 1 %}
                  {{ 'product-' | append: svg_index | placeholder_svg_tag }}
                {% endif %}
              </div>

              {% if block.settings.button_label != blank and item_link != blank %}
                <a href="{{ item_link }}" class="sh-showcase-slide-btn">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Next Arrow -->
      {% if section.settings.show_arrows %}
        <button type="button" class="sh-showcase-arrow sh-showcase-arrow-next" aria-label="Next Slide">
          {% render 'sh-arrows', arrow: 'next' %}
        </button>
      {% endif %}

      <!-- Side Category/Product Menu List -->
      {% if section.settings.show_side_list and section.blocks.size > 0 %}
        <div class="sh-showcase-side-list">
          {% for block in section.blocks %}
            {% liquid
              assign item_title = block.settings.title
              if item_title == blank and block.settings.product != blank
                assign item_title = block.settings.product.title
              elsif item_title == blank
                assign item_title = 'Category ' | append: forloop.index
              endif
            %}
            <button
              type="button"
              class="sh-showcase-side-item{% if forloop.first %} is-active{% endif %}"
              data-go-to="{{ forloop.index0 }}"
            >
              {{ item_title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

    </div>

    <!-- Pagination Dots -->
    {% if section.settings.show_dots and section.blocks.size > 1 %}
      <div class="sh-showcase-dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="sh-showcase-dot{% if forloop.first %} is-active{% endif %}"
            data-go-to="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

<script>
  (function() {
    function initUpcomingShowcase(sectionEl) {
      if (!sectionEl) return;
      var stage = sectionEl.querySelector('[data-sh-showcase]');
      if (!stage) return;

      var capsule = sectionEl.querySelector('[data-sh-capsule]');
      var slides = sectionEl.querySelectorAll('.sh-showcase-slide');
      var dots = sectionEl.querySelectorAll('.sh-showcase-dot');
      var sideItems = sectionEl.querySelectorAll('.sh-showcase-side-item');
      var prevBtn = sectionEl.querySelector('.sh-showcase-arrow-prev');
      var nextBtn = sectionEl.querySelector('.sh-showcase-arrow-next');

      if (!slides.length) return;

      var currentIndex = 0;
      var totalSlides = slides.length;
      var autoplayTimer = null;
      var autoplayEnabled = {{ section.settings.autoplay | json }};
      var autoplayDelay = {{ section.settings.autoplay_speed | times: 1000 }};

      function goToSlide(index) {
        if (index < 0) {
          currentIndex = totalSlides - 1;
        } else if (index >= totalSlides) {
          currentIndex = 0;
        } else {
          currentIndex = index;
        }

        slides.forEach(function(slide, i) {
          if (i === currentIndex) {
            slide.classList.add('is-active');
            if (capsule && slide.dataset.bg) {
              capsule.style.backgroundColor = slide.dataset.bg;
            }
          } else {
            slide.classList.remove('is-active');
          }
        });

        dots.forEach(function(dot, i) {
          dot.classList.toggle('is-active', i === currentIndex);
        });

        sideItems.forEach(function(item, i) {
          item.classList.toggle('is-active', i === currentIndex);
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          prevSlide();
          resetAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          nextSlide();
          resetAutoplay();
        });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var targetIndex = parseInt(this.getAttribute('data-go-to'), 10);
          goToSlide(targetIndex);
          resetAutoplay();
        });
      });

      sideItems.forEach(function(item) {
        item.addEventListener('click', function() {
          var targetIndex = parseInt(this.getAttribute('data-go-to'), 10);
          goToSlide(targetIndex);
          resetAutoplay();
        });
      });

      // Touch Swipe Support
      var touchStartX = 0;
      var touchEndX = 0;

      capsule.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      capsule.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });

      function handleGesture() {
        var diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          resetAutoplay();
        }
      }

      function startAutoplay() {
        if (!autoplayEnabled || totalSlides <= 1) return;
        autoplayTimer = setInterval(nextSlide, autoplayDelay);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      startAutoplay();

      stage.addEventListener('mouseenter', stopAutoplay);
      stage.addEventListener('mouseleave', startAutoplay);
    }

    var currentSection = document.getElementById('sh-showcase-{{ section.id }}');
    if (currentSection) {
      initUpcomingShowcase(currentSection);
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.querySelector('#sh-showcase-{{ section.id }}')) {
        initUpcomingShowcase(e.target.querySelector('#sh-showcase-{{ section.id }}'));
      }
    });

    document.addEventListener('shopify:block:select', function(e) {
      var blockId = e.detail.blockId;
      var slide = document.querySelector('.sh-showcase-slide[data-block-id="' + blockId + '"]');
      if (slide) {
        var targetIndex = parseInt(slide.getAttribute('data-index'), 10);
        var sideBtn = document.querySelector('.sh-showcase-side-item[data-go-to="' + targetIndex + '"]');
        if (sideBtn) {
          sideBtn.click();
        } else {
          var dotBtn = document.querySelector('.sh-showcase-dot[data-go-to="' + targetIndex + '"]');
          if (dotBtn) dotBtn.click();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "SH: Upcoming showcase",
  "tag": "section",
  "class": "sh-section-hub-main",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Heading Main (Bold)",
      "default": "Upcoming Products"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix (Serif / Italic)",
      "default": "— The Next Collection"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (Desktop)",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "mob_heading_size",
      "label": "Heading Font Size (Mobile)",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Capsule Pill Shape & Style"
    },
    {
      "type": "range",
      "id": "capsule_width",
      "label": "Capsule Width Percentage",
      "min": 50,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "capsule_height_desktop",
      "label": "Capsule Height (Desktop)",
      "min": 320,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "capsule_height_mobile",
      "label": "Capsule Height (Mobile)",
      "min": 220,
      "max": 450,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "capsule_border_radius",
      "label": "Capsule Corner Radius",
      "min": 20,
      "max": 350,
      "step": 5,
      "unit": "px",
      "default": 300,
      "info": "Max radius (300px+) creates the smooth capsule/pill shape"
    },
    {
      "type": "color",
      "id": "default_capsule_bg",
      "label": "Default Pill Background Color",
      "default": "#D7E6C4"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "contain", "label": "Contain (Fits cleanly within pill)" },
        { "value": "cover", "label": "Cover (Fills entire pill)" }
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Image Pop-out (3D Floating Effect)"
    },
    {
      "type": "range",
      "id": "image_popout_desktop",
      "label": "Image Pop-out Above Capsule (Desktop)",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80,
      "info": "Extends the model's head/hat above the background capsule curve"
    },
    {
      "type": "range",
      "id": "image_popout_mobile",
      "label": "Image Pop-out Above Capsule (Mobile)",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image Max Width Percentage",
      "min": 50,
      "max": 100,
