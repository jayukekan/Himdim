  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  shopify-account.header__icon {
    --shopify-account-font-heading: var(--font-heading-family);
    --shopify-account-font-heading-weight: var(--font-heading-weight);
    --shopify-account-font-body: var(--font-body-family);
    --shopify-account-font-body-weight: var(--font-body-weight);
    --shopify-account-radius-base: var(--popup-corner-radius);
    --shopify-account-radius-button: var(--buttons-radius);
    --shopify-account-radius-button-small: var(--buttons-radius);
    --shopify-account-radius-input: var(--inputs-radius);
    --shopify-account-color-background: rgb(var(--color-background));
    --shopify-account-color-text: rgb(var(--color-foreground));
    --shopify-account-color-accent: rgb(var(--color-button));
    --shopify-account-color-accent-text: rgb(var(--color-button-text));
    --shopify-account-dialog-position-top: var(--account-dialog-top, var(--header-height, 0px));
  }

  shopify-account.header__icon:not(:defined) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 4.4rem;
    height: 4.4rem;
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.enable_transparent_header -%}
    {%- if section.settings.transparent_header_home_only == false or request.page_type == 'index' -%}
      .section-header {
        position: relative;
        margin-bottom: calc(-1 * var(--header-height, 70px)) !important;
        z-index: 10;
        background: transparent !important;
      }

      .section-header.shopify-section-header-sticky {
        position: sticky;
        top: 0;
      }

      .section-header .header-wrapper {
        background: transparent !important;
        background-color: transparent !important;
        border-bottom: none !important;
        box-shadow: none !important;
        transition: background-color 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
      }

      .section-header.scrolled-past-header .header-wrapper {
        background-color: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05) !important;
      }

      .section-header.menu-open .header-wrapper {
        background-color: rgb(var(--color-background)) !important;
        border-bottom: 1px solid rgba(var(--color-foreground), 0.08) !important;
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.enable_icon_white_bg -%}
    .header__icon--menu,
    .header__search .header__icon--search,
    .header__icon--account,
    .header__icon--cart,
    .header__icons .gp-wishlist-button {
      background-color: {{ section.settings.header_icon_bg | default: '#ffffff' }} !important;
      color: {{ section.settings.header_icon_color | default: '#121212' }} !important;
      border-radius: 50% !important;
      width: 4.4rem !important;
      height: 4.4rem !important;
      min-width: 4.4rem !important;
      min-height: 4.4rem !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12) !important;
      border: 1px solid rgba(0, 0, 0, 0.06) !important;
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease !important;
      cursor: pointer;
      position: relative;
    }

    .header__icon--menu:hover,
    .header__search .header__icon--search:hover,
    .header__icon--account:hover,
    .header__icon--cart:hover,
    .header__icons .gp-wishlist-button:hover {
      transform: scale(1.08) !important;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18) !important;
    }

    .header__icon--menu span,
    .header__icon--cart .svg-wrapper,
    .header__search .header__icon--search > span,
    .header__icon--account .svg-wrapper {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
    }

    .header__search .header__icon--search .svg-wrapper {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
    }

    /* Fix search modal toggle icon: hide close X when closed, hide magnifying glass when open */
    .header__search details:not([open]) .header__icon-close {
      display: none !important;
    }

    .header__search details[open] .header__icon--search .svg-wrapper:not(.header__icon-close) {
      display: none !important;
    }

    .header__search details[open] .header__icon-close {
      display: flex !important;
    }

    .header__icon--menu .icon,
    .header__search .header__icon--search .icon,
    .header__icon--account .icon,
    .header__icon--cart .icon,
    .header__icons .gp-wishlist-button-icon {
      width: 2rem !important;
      height: 2rem !important;
      color: {{ section.settings.header_icon_color | default: '#121212' }} !important;
      fill: currentColor !important;
    }

    .header__icons {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      gap: 1rem !important;
      padding-right: 0.5rem !important;
    }

    .header__icon--cart {
      margin-right: 0 !important;
    }

    header-drawer {
      margin-left: 0 !important;
    }

    .cart-count-bubble {
      position: absolute !important;
      top: -2px !important;
      right: -2px !important;
      background-color: #000000 !important;
      color: #ffffff !important;
      border: 2px solid #ffffff !important;
      width: 1.9rem !important;
      height: 1.9rem !important;
      border-radius: 50% !important;
      font-size: 1rem !important;
      font-weight: 700 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2) !important;
      line-height: 1 !important;
      margin: 0 !important;
      bottom: auto !important;
      left: auto !important;
    }

    @media screen and (max-width: 749px) {
      .header {
        grid-template-columns: auto 1fr auto !important;
        padding-left: 1.2rem !important;
        padding-right: 1.2rem !important;
      }
      .header__icon--menu,
      .header__search .header__icon--search,
      .header__icon--account,
      .header__icon--cart,
      .header__icons .gp-wishlist-button {
        width: 3.8rem !important;
        height: 3.8rem !important;
        min-width: 3.8rem !important;
        min-height: 3.8rem !important;
      }
      .header__icon--menu .icon,
      .header__search .header__icon--search .icon,
      .header__icon--account .icon,
      .header__icon--cart .icon,
      .header__icons .gp-wishlist-button-icon {
        width: 1.8rem !important;
        height: 1.8rem !important;
      }
      .header__icons {
        gap: 0.6rem !important;
        padding-right: 0 !important;
      }
    }
  {%- endif -%}

  /* =========================================================
     CUSTOM LUXURY SEARCH MODAL & PREDICTIVE SEARCH
     ========================================================= */
  details-modal.header__search details[open] .search-modal {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    background-color: {{ section.settings.search_modal_bg | default: '#f4f0ec' }} !important;
    z-index: 99999 !important;
    opacity: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
    padding: 6rem 2rem 5rem 2rem !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
    animation: searchModalSlideDown 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  @keyframes searchModalSlideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-modal .modal-overlay {
    display: none !important;
  }

  /* Close button at top right */
  .search-modal .search-modal__close-button {
    position: absolute !important;
    top: 3.5rem !important;
    right: 4rem !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    color: #1a1a1a !important;
    width: 4.4rem !important;
    height: 4.4rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 100000 !important;
    transition: transform 0.2s ease, opacity 0.2s ease;
    padding: 0 !important;
    line-height: 1 !important;
  }

  .search-modal .search-modal__close-button:hover {
    transform: scale(1.15);
    opacity: 0.7;
  }

  .search-modal .search-modal__close-button svg {
    width: 2.4rem !important;
    height: 2.4rem !important;
    stroke: currentColor !important;
    display: block !important;
  }

  /* Centered content box */
  .search-modal .search-modal__content {
    width: 100% !important;
    max-width: 660px !important;
    margin: 2rem auto 0 auto !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    position: relative !important;
    background: transparent !important;
  }

  .search-modal .search-modal__form {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Clean underline input */
  .search-modal .field {
    position: relative !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    margin: 0 !important;
    background: transparent !important;
  }

  .search-modal .field:after,
  .search-modal .field:before {
    content: none !important;
    display: none !important;
  }

  .search-modal input.search__input {
    background: transparent !important;
    border: none !important;
    border-bottom: 1.5px solid #2b2b2b !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: inherit !important;
    font-size: 2.2rem !important;
    color: #121212 !important;
    padding: 0.6rem 6.5rem 0.6rem 0.2rem !important;
    width: 100% !important;
    height: auto !important;
    line-height: 1.4 !important;
    outline: none !important;
    transition: border-color 0.2s ease;
  }

  .search-modal input.search__input:focus {
    border-bottom-color: #000000 !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .search-modal input.search__input::placeholder {
    color: #767676 !important;
    font-weight: 300 !important;
    opacity: 0.85 !important;
    font-style: normal;
  }

  .search-modal .field__label {
    display: none !important;
  }

  /* Right-side search & reset buttons */
  .search-modal .search__button {
    position: absolute !important;
    right: 0 !important;
    bottom: 0.6rem !important;
    top: auto !important;
    width: 3.6rem !important;
    height: 3.6rem !important;
    background: transparent !important;
    border: none !important;
    color: #2b2b2b !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    z-index: 30 !important;
    pointer-events: auto !important;
    transition: transform 0.15s ease, color 0.15s ease !important;
  }

  .search-modal .search__button:hover {
    color: #000000 !important;
    transform: scale(1.12) !important;
  }

  .search-modal .search__button .icon,
  .search-modal .search__button .svg-wrapper,
  .search-modal .search__button svg {
    width: 2.2rem !important;
    height: 2.2rem !important;
    fill: currentColor !important;
    pointer-events: none !important;
  }

  /* Disable native browser search cancel button in Webkit/Blink */
  .search-modal input[type="search"]::-webkit-search-cancel-button,
  .search-modal input[type="search"]::-webkit-search-decoration,
  .search-modal input[type="search"]::-webkit-search-results-button,
  .search-modal input[type="search"]::-webkit-search-results-decoration {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: none !important;
  }

  .search-modal .reset__button {
    position: absolute !important;
    right: 3.5rem !important;
    bottom: 0.8rem !important;
    top: auto !important;
    width: 2.4rem !important;
    height: 2.4rem !important;
    background: transparent !important;
    border: none !important;
    color: #2f6bb0 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    line-height: 1 !important;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .search-modal .reset__button:hover {
    opacity: 0.8;
    transform: scale(1.15);
  }

  .search-modal .reset__button.hidden {
    display: none !important;
  }

  .search-modal .reset__button svg {
    width: 1.6rem !important;
    height: 1.6rem !important;
    stroke: currentColor !important;
    display: block !important;
  }

  /* Popular searches row */
  .header-search__popular {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    font-size: 1.45rem;
    flex-wrap: wrap;
    line-height: 1.5;
  }

  .header-search__popular-label {
    color: {{ section.settings.search_popular_label_color | default: '#9c5436' }};
    font-weight: 500;
    font-style: italic;
    font-family: inherit;
  }

  .header-search__popular-tags {
    display: inline-flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .header-search__tag-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 1.45rem;
    color: #2b2b2b;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease;
    font-family: inherit;
  }

  .header-search__tag-btn:hover {
    color: {{ section.settings.search_popular_label_color | default: '#9c5436' }};
    text-decoration: underline;
  }

  /* Predictive search live results */
  .search-modal .predictive-search--header {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: 100% !important;
    max-width: 660px !important;
    margin-top: 3.5rem !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    max-height: 520px !important;
    overflow-y: auto !important;
    padding: 0 0.8rem 2rem 0 !important;
  }

  .search-modal .predictive-search__results-groups-wrapper {
    display: block !important;
    border: none !important;
    padding: 0 !important;
  }

  .search-modal .predictive-search__result-group {
    display: block !important;
    width: 100% !important;
  }

  .search-modal .predictive-search__heading {
    font-size: 1.2rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.16em !important;
    color: #777777 !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
    padding: 0 0 1rem 0 !important;
    margin: 0 0 1.8rem 0 !important;
    font-weight: 500 !important;
    text-align: left !important;
  }

  .search-modal .predictive-search__results-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.2rem !important;
    padding: 0 !important;
    margin: 0 !important;
    list-style: none !important;
  }

  .search-modal .predictive-search__list-item {
    margin: 0 !important;
    padding: 0 !important;
  }

  .search-modal .predictive-search__item--link-with-thumbnail {
    display: flex !important;
    align-items: center !important;
    gap: 1.6rem !important;
    padding: 0.6rem 0.8rem !important;
    border-radius: 4px !important;
    background: transparent !important;
    text-decoration: none !important;
    transition: background-color 0.2s ease !important;
  }

  .search-modal .predictive-search__item--link-with-thumbnail:hover {
    background-color: rgba(0, 0, 0, 0.035) !important;
  }

  .search-modal .predictive-search__image {
    width: 52px !important;
    height: 72px !important;
    min-width: 52px !important;
    min-height: 72px !important;
    object-fit: cover !important;
    border-radius: 2px !important;
    background-color: #e5e0d8 !important;
    flex-shrink: 0 !important;
  }

  .search-modal .predictive-search__item-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 0.4rem !important;
    flex: 1 !important;
  }

  .search-modal .predictive-search__item-heading {
    font-size: 1.45rem !important;
    font-weight: 400 !important;
    color: #1a1a1a !important;
    line-height: 1.35 !important;
    margin: 0 !important;
    text-align: left !important;
    transition: color 0.15s ease;
  }

  .search-modal .predictive-search__item--link-with-thumbnail:hover .predictive-search__item-heading {
    color: #000000 !important;
  }

  .search-modal .predictive-search__item .price {
    font-size: 1.35rem !important;
    line-height: 1.3 !important;
    margin: 0 !important;
  }

  /* Prevent duplicate price rendering */
  .search-modal .predictive-search__item .price--on-sale .price__regular {
    display: none !important;
  }

  .search-modal .predictive-search__item .price:not(.price--on-sale) .price__sale {
    display: none !important;
  }

  .search-modal .predictive-search__item .price__sale {
    display: flex !important;
    align-items: center !important;
    gap: 0.8rem !important;
    flex-wrap: wrap !important;
  }

  .search-modal .predictive-search__item .price__regular {
    display: flex !important;
    align-items: center !important;
  }

  .search-modal .predictive-search__item .price-item--sale,
  .search-modal .predictive-search__item .price-item--regular {
    color: #333333 !important;
    font-weight: 500 !important;
  }

  .search-modal .predictive-search__item .price--on-sale .price-item--regular {
    color: #8c8c8c !important;
    text-decoration: line-through !important;
    font-weight: 400 !important;
  }

  .search-modal .predictive-search__search-for-button {
    margin-top: 1.5rem !important;
    border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
    padding-top: 1rem !important;
  }

  /* Custom scrollbar for search modal */
  .search-modal .predictive-search--header::-webkit-scrollbar,
  details-modal.header__search details[open] .search-modal::-webkit-scrollbar {
    width: 6px !important;
  }

  .search-modal .predictive-search--header::-webkit-scrollbar-track,
  details-modal.header__search details[open] .search-modal::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.04) !important;
    border-radius: 10px !important;
  }

  .search-modal .predictive-search--header::-webkit-scrollbar-thumb,
  details-modal.header__search details[open] .search-modal::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.22) !important;
    border-radius: 10px !important;
  }

  /* Responsive for mobile */
  @media screen and (max-width: 749px) {
    details-modal.header__search details[open] .search-modal {
      padding: 5rem 1.5rem 3rem 1.5rem !important;
    }
    .search-modal .search-modal__close-button {
      top: 1.5rem !important;
      right: 1.5rem !important;
    }
    .search-modal input.search__input {
      font-size: 1.8rem !important;
      padding-right: 5.5rem !important;
    }
    .header-search__popular {
      font-size: 1.35rem !important;
      gap: 0.6rem !important;
    }
    .header-search__popular-tags {
      gap: 0.8rem !important;
    }
    .header-search__tag-btn {
      font-size: 1.35rem !important;
    }
    .search-modal .predictive-search__image {
      width: 46px !important;
      height: 64px !important;
      min-width: 46px !important;
      min-height: 64px !important;
    }
    .search-modal .predictive-search__item-heading {
      font-size: 1.35rem !important;
    }
    .search-modal .predictive-search__item .price {
      font-size: 1.25rem !important;
    }
