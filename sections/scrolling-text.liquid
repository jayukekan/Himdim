<section
  class="scrolling-text scrolling-text--font-{{ section.settings.font_family }}{% if section.settings.pause_on_hover %} scrolling-text--pause-on-hover{% endif %}{% if section.settings.show_border %} scrolling-text--border{% endif %}"
  style="--scrolling-text-background: {{ section.settings.background_color }}; --scrolling-text-color: {{ section.settings.text_color }}; --scrolling-text-border: {{ section.settings.border_color }}; --scrolling-text-font-size-desktop: {{ section.settings.font_size_desktop }}px; --scrolling-text-font-size-mobile: {{ section.settings.font_size_mobile }}px; --scrolling-text-font-weight: {{ section.settings.font_weight }}; --scrolling-text-letter-spacing: {{ section.settings.letter_spacing }}px; --scrolling-text-line-height: {{ section.settings.line_height | divided_by: 100.0 }}; --scrolling-text-transform: {{ section.settings.text_transform }}; --scrolling-text-outline-width: {{ section.settings.outline_width }}px; --scrolling-text-padding-top: {{ section.settings.padding_top }}px; --scrolling-text-padding-bottom: {{ section.settings.padding_bottom }}px; --scrolling-text-padding-horizontal: {{ section.settings.padding_horizontal }}px; --scrolling-text-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --scrolling-text-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --scrolling-text-padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile }}px; --scrolling-text-gap: {{ section.settings.item_gap }}px; --scrolling-text-duration: {{ section.settings.animation_speed }}s;"
  {% if section.settings.accessibility_label != blank %}
    aria-label="{{ section.settings.accessibility_label | escape }}"
  {% endif %}
>
  <div class="scrolling-text__viewport">
    <div class="scrolling-text__track scrolling-text__track--{{ section.settings.direction }}">
      <div class="scrolling-text__group">
        {% render 'scrolling-text-items', blocks: section.blocks, duplicate: false, fallback_color: section.settings.text_color %}
      </div>
      <div class="scrolling-text__group" aria-hidden="true">
        {% render 'scrolling-text-items', blocks: section.blocks, duplicate: true, fallback_color: section.settings.text_color %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .scrolling-text {
    overflow: hidden;
    color: var(--scrolling-text-color);
    background: var(--scrolling-text-background);
    padding: var(--scrolling-text-padding-top) var(--scrolling-text-padding-horizontal) var(--scrolling-text-padding-bottom);
  }

  .scrolling-text--border {
    border-block: 1px solid var(--scrolling-text-border);
  }

  .scrolling-text__viewport {
    overflow: hidden;
  }

  .scrolling-text__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: scrolling-text-loop var(--scrolling-text-duration) linear infinite;
  }

  .scrolling-text__track--right {
    animation-direction: reverse;
  }

  .scrolling-text__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-around;
    min-width: 100vw;
    gap: var(--scrolling-text-gap);
    padding-inline: calc(var(--scrolling-text-gap) / 2);
  }

  .scrolling-text__item {
    flex: 0 0 auto;
    color: var(--scrolling-text-item-color, var(--scrolling-text-color));
    font-size: var(--scrolling-text-font-size-desktop);
    font-weight: var(--scrolling-text-font-weight);
    letter-spacing: var(--scrolling-text-letter-spacing);
    line-height: var(--scrolling-text-line-height);
    text-transform: var(--scrolling-text-transform);
    white-space: nowrap;
  }

  .scrolling-text__item--outline {
    color: transparent;
    -webkit-text-stroke: var(--scrolling-text-outline-width) var(--scrolling-text-item-color, var(--scrolling-text-color));
    paint-order: stroke fill;
  }

  .scrolling-text--font-body .scrolling-text__item {
    font-family: var(--font-body-family);
  }

  .scrolling-text--font-heading .scrolling-text__item {
    font-family: var(--font-heading-family);
  }

  .scrolling-text__link {
    color: inherit;
    text-decoration: none;
  }

  .scrolling-text__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .scrolling-text--pause-on-hover:hover .scrolling-text__track,
  .scrolling-text:focus-within .scrolling-text__track {
    animation-play-state: paused;
  }

  @keyframes scrolling-text-loop {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .scrolling-text {
      padding: var(--scrolling-text-padding-top-mobile) var(--scrolling-text-padding-horizontal-mobile) var(--scrolling-text-padding-bottom-mobile);
    }

    .scrolling-text__item {
      font-size: var(--scrolling-text-font-size-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolling-text__track {
      width: 100%;
      animation: none;
      transform: none;
    }

    .scrolling-text__group {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      min-width: 0;
    }

    .scrolling-text__group[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scrolling text",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F7EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6F7F37"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show top and bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#6F7F37"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "heading",
          "label": "Heading font"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": -1,
      "max": 5,
      "step": 0.1,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 120
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text style",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "outline_width",
      "min": 0.5,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Outline width",
      "default": 1
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile horizontal padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space between messages",
      "default": 48
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Loop duration",
      "info": "A lower value moves the text faster.",
      "default": 25
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store offers"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $300"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Style",
          "options": [
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "TIPS IN A FLASH",
            "text_style": "outline",
            "color": "#302F2A"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "YOUR ORDER SHIPS FAST",
            "text_style": "solid",
            "color": "#302F2A"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "EASY RETURNS",
            "text_style": "outline",
            "color": "#302F2A"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "MADE WITH CARE",
            "text_style": "solid",
            "color": "#302F2A"
          }
        }
      ]
    }
  ]
}
{% endschema %}
