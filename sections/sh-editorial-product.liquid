  #sh-editorial-{{ section.id }} .sh-fbt-check-box svg {
    width: 12px;
    height: 10px;
    stroke: #ffffff;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
