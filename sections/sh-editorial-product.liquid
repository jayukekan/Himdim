<script>
  (function() {
    function initEditorialProduct() {
      const sectionEl = document.getElementById('sh-editorial-{{ section.id }}');
      if (!sectionEl) return;

      const track = sectionEl.querySelector('#sh-gal-track-{{ section.id }}');
      const prevBtn = sectionEl.querySelector('#sh-gal-prev-{{ section.id }}');
      const nextBtn = sectionEl.querySelector('#sh-gal-next-{{ section.id }}');
      const slides = sectionEl.querySelectorAll('.sh-editorial-gallery-slide');
      const dots = sectionEl.querySelectorAll('.sh-gallery-dot');

      // Gallery Slider Controls
      if (track && prevBtn && nextBtn && slides.length > 0) {
        function getSlideScrollAmount() {
          const firstSlide = slides[0];
          return firstSlide ? firstSlide.offsetWidth + 16 : track.clientWidth / 2;
        }

        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -getSlideScrollAmount(), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: getSlideScrollAmount(), behavior: 'smooth' });
        });

        // Update mobile dots on scroll
        track.addEventListener('scroll', function() {
          if (dots.length === 0) return;
          const scrollLeft = track.scrollLeft;
          const slideWidth = slides[0].offsetWidth;
          const activeIndex = Math.round(scrollLeft / slideWidth);

          dots.forEach((dot, idx) => {
            if (idx === activeIndex) {
              dot.classList.add('is-active');
            } else {
              dot.classList.remove('is-active');
            }
          });
        }, { passive: true });
      }

      // Quantity controls
      const quantityInput = sectionEl.querySelector('#sh-quantity-{{ section.id }}');
      sectionEl.querySelectorAll('[data-quantity-action]').forEach(btn => {
        btn.addEventListener('click', function() {
          if (!quantityInput) return;
          const currentVal = Math.max(1, parseInt(quantityInput.value, 10) || 1);
          if (this.getAttribute('data-quantity-action') === 'increase') {
            quantityInput.value = currentVal + 1;
          } else {
            quantityInput.value = Math.max(1, currentVal - 1);
          }
        });
      });

      // Variants Data & Switching
      const variantsDataEl = sectionEl.querySelector('#sh-variants-data-{{ section.id }}');
      let variantsData = [];
      if (variantsDataEl) {
        try {
          variantsData = JSON.parse(variantsDataEl.textContent);
        } catch (e) {
          console.error('Error parsing variants data', e);
        }
      }

      const variantInput = sectionEl.querySelector('#sh-variant-id-{{ section.id }}');
      const selects = sectionEl.querySelectorAll('.sh-editorial-select');
      const patternBtns = sectionEl.querySelectorAll('.sh-pattern-swatch-btn');
      const priceContainer = sectionEl.querySelector('#sh-price-{{ section.id }}');
      const buyBtn = sectionEl.querySelector('#sh-buy-btn-{{ section.id }}');

      function formatMoney(cents) {
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(cents);
        }
        return 'Rs. ' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 });
      }

      function getSelectedOptions() {
        const selected = [];
        selects.forEach(select => {
          selected.push(select.value);
        });
        return selected;
      }

      function updateVariant() {
        if (!variantsData.length) return;
        const selected = getSelectedOptions();

        const matchedVariant = variantsData.find(v => {
          return selected.every((val, idx) => v.options[idx] === val);
        });

        if (matchedVariant) {
          if (variantInput) variantInput.value = matchedVariant.id;

          // Update URL
          if (window.location.pathname.includes('/products/')) {
            const url = new URL(window.location.href);
            url.searchParams.set('variant', matchedVariant.id);
            window.history.replaceState({}, '', url.toString());
          }

          // Update Price
          if (priceContainer) {
            let priceHtml = '';
            if (matchedVariant.compare_at_price > matchedVariant.price) {
              priceHtml += '<span class="sh-price-compare">' + formatMoney(matchedVariant.compare_at_price) + '</span> ';
            }
            priceHtml += '<span class="sh-price-regular">' + formatMoney(matchedVariant.price) + '</span>';
            priceContainer.innerHTML = priceHtml;
          }

          // Update Button State
          if (buyBtn) {
            if (matchedVariant.available) {
              buyBtn.removeAttribute('disabled');
              buyBtn.textContent = '{{ section.settings.buy_now_label | default: "Buy Now" }}';
            } else {
              buyBtn.setAttribute('disabled', 'true');
              buyBtn.textContent = 'Sold Out';
            }
          }

          // Scroll Gallery to Variant Image
          if (matchedVariant.featured_media && matchedVariant.featured_media.id && track) {
            const targetSlide = track.querySelector(`.sh-editorial-gallery-slide[data-media-id="${matchedVariant.featured_media.id}"]`);
            if (targetSlide) {
              track.scrollTo({ left: targetSlide.offsetLeft, behavior: 'smooth' });
            }
          }
        }
      }

      // Handle Select Dropdown changes
      selects.forEach(select => {
        select.addEventListener('change', function() {
          const optIdx = this.getAttribute('data-option-index');
          // Also sync any pattern swatch buttons matching this index
          patternBtns.forEach(btn => {
            if (btn.getAttribute('data-option-index') === optIdx) {
              if (btn.getAttribute('data-option-value') === select.value) {
                btn.classList.add('is-active');
              } else {
                btn.classList.remove('is-active');
              }
            }
          });
          updateVariant();
        });
      });

      // Handle Pattern Swatch clicks
      patternBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const optIdx = this.getAttribute('data-option-index');
          const optVal = this.getAttribute('data-option-value');

          patternBtns.forEach(b => {
            if (b.getAttribute('data-option-index') === optIdx) b.classList.remove('is-active');
          });
          this.classList.add('is-active');

          const matchingSelect = sectionEl.querySelector(`.sh-editorial-select[data-option-index="${optIdx}"]`);
          if (matchingSelect) {
            matchingSelect.value = optVal;
            matchingSelect.dispatchEvent(new Event('change'));
          } else {
            updateVariant();
          }
        });
      });

      // Instant Checkout via Buy Now Button
      if (buyBtn) {
        buyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const varId = variantInput ? variantInput.value : null;
          const qty = quantityInput ? Math.max(1, parseInt(quantityInput.value, 10) || 1) : 1;
          if (!varId) return;

          buyBtn.style.opacity = '0.7';
          buyBtn.textContent = 'Redirecting...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [{ id: parseInt(varId), quantity: qty }]
            })
          })
          .then(res => res.json())
          .then(() => {
            window.location.href = '/checkout';
          })
          .catch(err => {
            console.error('Checkout error', err);
            window.location.href = '/cart/' + varId + ':' + qty;
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEditorialProduct);
    } else {
      initEditorialProduct();
    }
    document.addEventListener('shopify:section:load', initEditorialProduct);
  })();
</script>

