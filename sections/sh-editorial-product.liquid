    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 4px;
    cursor: pointer;
    outline: none;
    max-width: 160px;
    transition: all 0.2s ease;
  }

  #sh-editorial-{{ section.id }} .sh-fbt-variant-select:hover,
  #sh-editorial-{{ section.id }} .sh-fbt-variant-select:focus {
