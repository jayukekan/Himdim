{%- comment -%}
  Editorial Luxury Product Showcase (3-Column Asymmetric Fashion Layout)
  Inspired by high-end luxury fashion e-commerce (Rick Owens, Balenciaga, Acne Studios).
  Features:
  - Left column: Secondary media carousel with arrows + Minimalist expandable accordions
  - Center column: Tall portrait hero model image
  - Right column: Bold condensed typography, dynamic variant swatches (Color & Size), dual CTA buttons
  - 100% responsive for Desktop, Tablet, and Mobile
{%- endcomment -%}

{%- liquid
  if template.name == 'product'
    assign editorial_product = product
  else
    assign editorial_product = section.settings.product | default: product | default: all_products.first
  endif
  assign product = editorial_product

  assign current_variant = product.selected_or_first_available_variant

  assign color_option_index = -1
  assign size_option_index = -1

  for option in product.options_with_values
    assign opt_name_down = option.name | downcase
    if opt_name_down contains 'color' or opt_name_down contains 'colour' or opt_name_down contains 'shade'
      assign color_option_index = forloop.index0
    elsif opt_name_down contains 'size'
      assign size_option_index = forloop.index0
    endif
  endfor
-%}

<div
  id="sh-editorial-{{ section.id }}"
  class="sh-editorial-product-section sh-editorial-product-section--compact"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="sh-editorial-container">
    {%- if section.settings.show_breadcrumbs and section.settings.breadcrumb_position != 'right_col' -%}
      {% render 'breadcrumb', extra_classes: 'sh-breadcrumbs--top', product: product, collection: collection %}
    {%- endif -%}

    {%- comment -%} Capture Thumbnails Carousel Markup {%- endcomment -%}
    {%- capture thumbnails_html -%}
      {%- if product.media.size > 1 or product == blank -%}
        <div class="sh-editorial-carousel-wrapper">
          <div class="sh-editorial-thumbs-track" id="sh-thumbs-track-{{ section.id }}">
            {%- if product != blank -%}
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <div
                    class="sh-editorial-thumb-slide{% if forloop.first %} is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-image-src="{{ media | image_url: width: 1200 }}"
                    data-index="{{ forloop.index0 }}"
                  >
                    <div class="sh-editorial-thumb-inner">
                      <img
                        src="{{ media | image_url: width: 350 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="240"
                        height="320"
                      >
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                <div class="sh-editorial-thumb-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
                  <div class="sh-editorial-thumb-inner placeholder">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <!-- Arrows Underneath Carousel -->
          <div class="sh-editorial-carousel-nav">
            <button
              type="button"
              class="sh-editorial-nav-btn sh-nav-prev"
              id="sh-prev-{{ section.id }}"
              aria-label="Previous image"
            >
              <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="7" x2="1" y2="7"></line>
                <polyline points="7 1 1 7 7 13"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="sh-editorial-nav-btn sh-nav-next"
              id="sh-next-{{ section.id }}"
              aria-label="Next image"
            >
              <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="1" y1="7" x2="19" y2="7"></line>
                <polyline points="13 1 19 7 13 13"></polyline>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}
    {%- endcapture -%}

    <div class="sh-editorial-grid">

      <!-- ================= LEFT COLUMN ================= -->
      <div class="sh-editorial-col sh-editorial-col--left">
        <!-- Desktop Thumbnail Gallery Carousel (Left Column) -->
        <div class="sh-desktop-only-thumbnails">
          {{ thumbnails_html }}
        </div>

        <!-- Expandable Minimalist Accordions -->
        <div class="sh-editorial-accordions">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <details class="sh-editorial-accordion-item"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
                <summary class="sh-editorial-accordion-summary">
                  <span class="sh-editorial-accordion-title">{{ block.settings.title | escape }}</span>
                  <span class="sh-editorial-accordion-chevron">
                    <svg width="14" height="9" viewBox="0 0 14 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="1 2 7 8 13 2"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="sh-editorial-accordion-body rte">
                  {%- if block.type == 'description' -%}
                    {%- if product != blank and product.description != blank -%}
                      {{ product.description }}
                    {%- else -%}
                      <p>{{ block.settings.content | default: 'Wide leg pants in technical fabric. Elasticated waist band with side slit pockets and drawstring on hem.' }}</p>
                    {%- endif -%}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          {%- else -%}
            <details class="sh-editorial-accordion-item" open>
              <summary class="sh-editorial-accordion-summary">
                <span class="sh-editorial-accordion-title">DESCRIPTION</span>
                <span class="sh-editorial-accordion-chevron">
                  <svg width="14" height="9" viewBox="0 0 14 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 2 7 8 13 2"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="sh-editorial-accordion-body rte">
                {%- if product != blank and product.description != blank -%}
                  {{ product.description }}
                {%- else -%}
                  <p>Black Wide Leg Pants In Technical Nylon<br>Elasticated Waist Band<br>Side Slit Pockets With Zip<br>Drawstring On Hem To Adjust The Leg<br>Zip-Off System Below The Knee</p>
                {%- endif -%}
              </div>
            </details>
            <details class="sh-editorial-accordion-item">
              <summary class="sh-editorial-accordion-summary">
                <span class="sh-editorial-accordion-title">DETAILS</span>
                <span class="sh-editorial-accordion-chevron">
                  <svg width="14" height="9" viewBox="0 0 14 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 2 7 8 13 2"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="sh-editorial-accordion-body rte">
                <p>100% Technical Nylon.<br>Dry clean or hand wash cold.<br>Made in Portugal.</p>
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>

      <!-- ================= CENTER COLUMN ================= -->
      <div class="sh-editorial-col sh-editorial-col--center">
        <!-- Main Product Image -->
        <div class="sh-editorial-hero-media" id="sh-hero-media-{{ section.id }}">
          {%- assign hero_img = current_variant.featured_image | default: product.featured_image -%}
          {%- if hero_img != blank -%}
            <img
              id="sh-hero-img-{{ section.id }}"
              src="{{ hero_img | image_url: width: 1400 }}"
              alt="{{ hero_img.alt | default: product.title | escape }}"
              width="600"
              height="850"
              class="sh-editorial-main-img"
              loading="eager"
            >
          {%- elsif product != blank and product.media.size > 0 -%}
            <img
              id="sh-hero-img-{{ section.id }}"
              src="{{ product.media.first | image_url: width: 1400 }}"
              alt="{{ product.title | escape }}"
              width="600"
              height="850"
              class="sh-editorial-main-img"
              loading="eager"
            >
          {%- else -%}
            <div class="sh-editorial-hero-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Thumbnail Gallery Carousel (Mobile only: Placed JUST BELOW Main Hero Image) -->
        <div class="sh-mobile-only-thumbnails">
          {{ thumbnails_html }}
        </div>
      </div>

      <!-- ================= RIGHT COLUMN ================= -->
      <div class="sh-editorial-col sh-editorial-col--right">
        {%- if section.settings.show_breadcrumbs and section.settings.breadcrumb_position == 'right_col' -%}
          {% render 'breadcrumb', extra_classes: 'sh-breadcrumbs--right-col', product: product, collection: collection %}
        {%- endif -%}

        <!-- Title & Heading -->
        <h2 class="sh-editorial-product-title">
          {%- if product != blank -%}
            {{ product.title }}
          {%- else -%}
            CAMILLE HENROT ARTWORK TROUSERS
          {%- endif -%}
        </h2>

        <!-- Price -->
        <div class="sh-editorial-price-container" id="sh-price-{{ section.id }}">
          {%- if product != blank -%}
            {% render 'price', product: product, use_variant: true, show_badges: false %}
          {%- else -%}
            <span class="price-item price-item--regular">1.150,00€</span>
          {%- endif -%}
        </div>

        <!-- Variant Options Form -->
        {%- assign product_form_id = 'sh-product-form-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'sh-editorial-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id | default: product.variants.first.id }}" id="sh-variant-id-{{ section.id }}">

          {%- if product != blank and product.has_only_default_variant == false -%}
            <div class="sh-editorial-options-wrapper">
              {%- for option in product.options_with_values -%}
                {%- assign opt_idx = forloop.index0 -%}
                {%- assign opt_name_down = option.name | downcase -%}

                {%- if opt_idx == color_option_index -%}
                  <!-- Color Swatches -->
                  <div class="sh-editorial-option-group" data-option-index="{{ opt_idx }}">
                    <div class="sh-editorial-option-header">
                      <span class="sh-editorial-option-name">{{ option.name | upcase }}</span>
                      <span class="sh-editorial-option-divider">|</span>
                      <span class="sh-editorial-option-selected" id="sh-selected-color-{{ section.id }}">{{ option.selected_value | upcase }}</span>
                    </div>
                    <div class="sh-editorial-swatch-list">
                      {%- for value in option.values -%}
                        {%- assign is_selected = false -%}
                        {%- if option.selected_value == value -%}
                          {%- assign is_selected = true -%}
                        {%- endif -%}
                        {%- assign color_css = value | downcase | replace: ' ', '' -%}
                        <button
                          type="button"
                          class="sh-editorial-color-swatch{% if is_selected %} is-active{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-option-value="{{ value | escape }}"
                          title="{{ value | escape }}"
                          aria-label="{{ value | escape }}"
                        >
                          <span
                            class="sh-editorial-swatch-color"
                            style="background-color: {{ color_css }};"
                          ></span>
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>

                {%- elsif opt_idx == size_option_index -%}
                  <!-- Size Selection Boxes -->
                  <div class="sh-editorial-option-group" data-option-index="{{ opt_idx }}">
                    <div class="sh-editorial-option-header">
                      <span class="sh-editorial-option-name">{{ option.name | upcase }}</span>
                      <span class="sh-editorial-option-divider">|</span>
                      <span class="sh-editorial-option-selected" id="sh-selected-size-{{ section.id }}">{{ option.selected_value }}</span>
                    </div>
                    <div class="sh-editorial-size-list">
                      {%- for value in option.values -%}
                        {%- assign is_selected = false -%}
                        {%- if option.selected_value == value -%}
                          {%- assign is_selected = true -%}
                        {%- endif -%}
                        <button
                          type="button"
                          class="sh-editorial-size-box{% if is_selected %} is-active{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>

                {%- else -%}
                  <!-- Other Options (Pills) -->
                  <div class="sh-editorial-option-group" data-option-index="{{ opt_idx }}">
                    <div class="sh-editorial-option-header">
                      <span class="sh-editorial-option-name">{{ option.name | upcase }}</span>
                      <span class="sh-editorial-option-divider">|</span>
                      <span class="sh-editorial-option-selected">{{ option.selected_value }}</span>
                    </div>
                    <div class="sh-editorial-size-list">
                      {%- for value in option.values -%}
                        {%- assign is_selected = false -%}
                        {%- if option.selected_value == value -%}
                          {%- assign is_selected = true -%}
                        {%- endif -%}
                        <button
                          type="button"
                          class="sh-editorial-size-box{% if is_selected %} is-active{% endif %}"
                          data-option-index="{{ opt_idx }}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- elsif product == blank -%}
            <!-- Placeholder Variant Options -->
            <div class="sh-editorial-options-wrapper">
              <div class="sh-editorial-option-group">
                <div class="sh-editorial-option-header">
                  <span class="sh-editorial-option-name">COLOR</span>
                  <span class="sh-editorial-option-divider">|</span>
                  <span class="sh-editorial-option-selected">BLACK</span>
                </div>
                <div class="sh-editorial-swatch-list">
                  <button type="button" class="sh-editorial-color-swatch is-active" title="Black">
                    <span class="sh-editorial-swatch-color" style="background-color: #000000;"></span>
                  </button>
                  <button type="button" class="sh-editorial-color-swatch" title="White">
                    <span class="sh-editorial-swatch-color" style="background-color: #ffffff; border: 1px solid #ccc;"></span>
                  </button>
                </div>
              </div>

              <div class="sh-editorial-option-group">
                <div class="sh-editorial-option-header">
                  <span class="sh-editorial-option-name">SIZE</span>
                  <span class="sh-editorial-option-divider">|</span>
                  <span class="sh-editorial-option-selected">37</span>
                </div>
                <div class="sh-editorial-size-list">
                  <button type="button" class="sh-editorial-size-box">36</button>
                  <button type="button" class="sh-editorial-size-box is-active">38</button>
                  <button type="button" class="sh-editorial-size-box">40</button>
                </div>
              </div>
            </div>
          {%- endif -%}

          <div class="sh-editorial-quantity">
            <label for="sh-quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <div class="sh-editorial-quantity-control">
              <button type="button" class="sh-editorial-quantity-button" data-quantity-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">−</button>
              <input id="sh-quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1">
              <button type="button" class="sh-editorial-quantity-button" data-quantity-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">+</button>
            </div>
          </div>

          <!-- CTA Buttons: Buy Product (Checkout) & Add to Cart -->
          <div class="sh-editorial-actions">
            <button
              type="button"
              class="sh-editorial-btn sh-editorial-btn--buy"
              id="sh-buy-btn-{{ section.id }}"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available or product == blank -%}
                {{ section.settings.buy_now_label | default: 'BUY PRODUCT' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>

            <button
              type="submit"
              name="add"
              class="sh-editorial-btn sh-editorial-btn--cart"
              id="sh-cart-btn-{{ section.id }}"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available or product == blank -%}
                {{ section.settings.add_to_cart_label | default: 'ADD TO CART' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        <div class="sh-editorial-fulfilment">
          <p><span>{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}</span></p>
          <p>{{ 'products.product.taxes_included' | t }}</p>
        </div>

        <!-- ================= FREQUENTLY BOUGHT TOGETHER ================= -->
        {%- if section.settings.show_fbt -%}
          {%- liquid
            assign fbt_prod_1 = blank
            assign fbt_prod_2 = blank

            if section.settings.fbt_products != blank and section.settings.fbt_products.count > 0
              for bp in section.settings.fbt_products
                if bp.id != product.id and bp.available
                  if fbt_prod_1 == blank
                    assign fbt_prod_1 = bp
                  elsif fbt_prod_2 == blank
                    assign fbt_prod_2 = bp
                    break
                  endif
                endif
              endfor
            endif

            if fbt_prod_1 == blank and product != blank
              assign target_coll = product.collections.first
              if target_coll == blank or target_coll.products_count < 2
                assign target_coll = collections.all
              endif
              for cp in target_coll.products
                if cp.id != product.id and cp.available
                  if fbt_prod_1 == blank
                    assign fbt_prod_1 = cp
                  elsif fbt_prod_2 == blank
                    assign fbt_prod_2 = cp
                    break
                  endif
                endif
              endfor
            endif

            if fbt_prod_1 == blank and product != blank
              for ap in collections.all.products
                if ap.id != product.id and ap.available
                  if fbt_prod_1 == blank
                    assign fbt_prod_1 = ap
                  elsif fbt_prod_2 == blank
                    assign fbt_prod_2 = ap
                    break
                  endif
                endif
              endfor
            endif

            assign has_fbt = false
            if fbt_prod_1 != blank or product == blank
              assign has_fbt = true
            endif
          -%}

          {%- if has_fbt -%}
            {%- liquid
              assign p0_price = current_variant.price | default: 64900
              assign p0_comp = current_variant.compare_at_price | default: p0_price

              if fbt_prod_1 != blank
                assign p1_variant = fbt_prod_1.selected_or_first_available_variant
                assign p1_price = p1_variant.price
                assign p1_comp = p1_variant.compare_at_price | default: p1_price
              else
                assign p1_price = 84900
                assign p1_comp = 84900
              endif

              assign bundle_init_total = p0_price | plus: p1_price
              assign bundle_init_comp = p0_comp | plus: p1_comp

              if fbt_prod_2 != blank
                assign p2_variant = fbt_prod_2.selected_or_first_available_variant
                assign p2_price = p2_variant.price
                assign p2_comp = p2_variant.compare_at_price | default: p2_price
                assign bundle_init_total = bundle_init_total | plus: p2_price
                assign bundle_init_comp = bundle_init_comp | plus: p2_comp
              endif
            -%}

            <div class="sh-fbt-wrapper" id="sh-fbt-{{ section.id }}">
              <h3 class="sh-fbt-heading">{{ section.settings.fbt_heading | default: 'Frequently bought together' }}</h3>

              <div class="sh-fbt-cards-list">
                <!-- Card 0: Current Product -->
                <div class="sh-fbt-card is-active" data-fbt-card="0">
                  <div class="sh-fbt-card-check">
                    <label class="sh-fbt-custom-check">
                      <input
                        type="checkbox"
                        class="sh-fbt-checkbox"
                        checked
                        disabled
                        data-fbt-index="0"
                        data-price="{{ p0_price }}"
                        data-compare-at="{{ p0_comp }}"
                      >
                      <span class="sh-fbt-check-box">
                        <svg viewBox="0 0 14 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="1.5 5.5 5 9 12.5 1.5"></polyline>
                        </svg>
                      </span>
                    </label>
                  </div>

                  <div class="sh-fbt-card-media">
                    {%- assign fbt_img_0 = current_variant.featured_image | default: product.featured_image -%}
                    {%- if fbt_img_0 != blank -%}
                      <img
                        id="sh-fbt-thumb-0-{{ section.id }}"
                        src="{{ fbt_img_0 | image_url: width: 200 }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                        width="64"
                        height="64"
                      >
                    {%- else -%}
                      <div class="sh-fbt-placeholder-img">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="sh-fbt-card-content">
                    <div class="sh-fbt-card-title">{{ product.title | default: 'Current Product' }}</div>
                    <div class="sh-fbt-card-pricing">
                      <span class="sh-fbt-card-price" id="sh-fbt-price-0-{{ section.id }}">{{ p0_price | money }}</span>
                      {%- if p0_comp > p0_price -%}
                        <span class="sh-fbt-card-compare" id="sh-fbt-compare-0-{{ section.id }}">{{ p0_comp | money }}</span>
                      {%- else -%}
                        <span class="sh-fbt-card-compare" id="sh-fbt-compare-0-{{ section.id }}" style="display: none;"></span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

                <!-- Card 1: Complementary Product 1 -->
                <div class="sh-fbt-card is-active" data-fbt-card="1">
                  <div class="sh-fbt-card-check">
                    <label class="sh-fbt-custom-check">
                      <input
                        type="checkbox"
                        class="sh-fbt-checkbox sh-fbt-toggle"
                        checked
                        data-fbt-index="1"
                        data-price="{{ p1_price }}"
                        data-compare-at="{{ p1_comp }}"
                      >
                      <span class="sh-fbt-check-box">
                        <svg viewBox="0 0 14 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="1.5 5.5 5 9 12.5 1.5"></polyline>
                        </svg>
                      </span>
                    </label>
                  </div>

                  <div class="sh-fbt-card-media">
                    {%- if fbt_prod_1 != blank and fbt_prod_1.featured_image != blank -%}
                      <img
                        id="sh-fbt-thumb-1-{{ section.id }}"
                        src="{{ fbt_prod_1.featured_image | image_url: width: 200 }}"
                        alt="{{ fbt_prod_1.title | escape }}"
                        loading="lazy"
                        width="64"
                        height="64"
                      >
                    {%- else -%}
                      <div class="sh-fbt-placeholder-img">
                        {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="sh-fbt-card-content">
                    {%- if fbt_prod_1 != blank -%}
                      <a href="{{ fbt_prod_1.url }}" target="_blank" class="sh-fbt-card-title">{{ fbt_prod_1.title }}</a>
                    {%- else -%}
                      <span class="sh-fbt-card-title">Complementary Fashion Piece</span>
                    {%- endif -%}
                    <div class="sh-fbt-card-pricing">
                      <span class="sh-fbt-card-price" id="sh-fbt-price-1-{{ section.id }}">{{ p1_price | money }}</span>
                      {%- if p1_comp > p1_price -%}
                        <span class="sh-fbt-card-compare" id="sh-fbt-compare-1-{{ section.id }}">{{ p1_comp | money }}</span>
                      {%- else -%}
                        <span class="sh-fbt-card-compare" id="sh-fbt-compare-1-{{ section.id }}" style="display: none;"></span>
                      {%- endif -%}
                    </div>
                    {%- if fbt_prod_1 != blank and fbt_prod_1.has_only_default_variant == false -%}
                      <div class="sh-fbt-card-variant">
                        <select
                          class="sh-fbt-variant-select"
                          data-fbt-index="1"
                          aria-label="Select size or variant"
                        >
                          {%- for variant in fbt_prod_1.variants -%}
                            <option
                              value="{{ variant.id }}"
                              data-price="{{ variant.price }}"
                              data-compare-at="{{ variant.compare_at_price | default: variant.price }}"
                              {% if variant.featured_image %}data-img="{{ variant.featured_image | image_url: width: 200 }}"{% endif %}
                              {% if variant == p1_variant %}selected{% endif %}
                              {% unless variant.available %}disabled{% endunless %}
                            >
                              Size: {{ variant.title }} {% unless variant.available %}(Sold out){% endunless %}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- elsif fbt_prod_1 != blank -%}
                      <input type="hidden" class="sh-fbt-variant-id" data-fbt-index="1" value="{{ p1_variant.id }}">
                    {%- endif -%}
                  </div>
                </div>

                <!-- Card 2: Complementary Product 2 (if present) -->
                {%- if fbt_prod_2 != blank -%}
                  <div class="sh-fbt-card is-active" data-fbt-card="2">
                    <div class="sh-fbt-card-check">
                      <label class="sh-fbt-custom-check">
                        <input
                          type="checkbox"
                          class="sh-fbt-checkbox sh-fbt-toggle"
                          checked
                          data-fbt-index="2"
                          data-price="{{ p2_price }}"
                          data-compare-at="{{ p2_comp }}"
                        >
                        <span class="sh-fbt-check-box">
                          <svg viewBox="0 0 14 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1.5 5.5 5 9 12.5 1.5"></polyline>
                          </svg>
                        </span>
                      </label>
                    </div>

                    <div class="sh-fbt-card-media">
                      {%- if fbt_prod_2.featured_image != blank -%}
                        <img
                          id="sh-fbt-thumb-2-{{ section.id }}"
                          src="{{ fbt_prod_2.featured_image | image_url: width: 200 }}"
                          alt="{{ fbt_prod_2.title | escape }}"
                          loading="lazy"
                          width="64"
                          height="64"
                        >
                      {%- else -%}
                        <div class="sh-fbt-placeholder-img">
                          {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="sh-fbt-card-content">
                      <a href="{{ fbt_prod_2.url }}" target="_blank" class="sh-fbt-card-title">{{ fbt_prod_2.title }}</a>
                      <div class="sh-fbt-card-pricing">
                        <span class="sh-fbt-card-price" id="sh-fbt-price-2-{{ section.id }}">{{ p2_price | money }}</span>
                        {%- if p2_comp > p2_price -%}
                          <span class="sh-fbt-card-compare" id="sh-fbt-compare-2-{{ section.id }}">{{ p2_comp | money }}</span>
                        {%- else -%}
                          <span class="sh-fbt-card-compare" id="sh-fbt-compare-2-{{ section.id }}" style="display: none;"></span>
                        {%- endif -%}
                      </div>
                      {%- if fbt_prod_2.has_only_default_variant == false -%}
                        <div class="sh-fbt-card-variant">
                          <select
                            class="sh-fbt-variant-select"
                            data-fbt-index="2"
                            aria-label="Select size or variant"
                          >
                            {%- for variant in fbt_prod_2.variants -%}
                              <option
                                value="{{ variant.id }}"
                                data-price="{{ variant.price }}"
                                data-compare-at="{{ variant.compare_at_price | default: variant.price }}"
                                {% if variant.featured_image %}data-img="{{ variant.featured_image | image_url: width: 200 }}"{% endif %}
                                {% if variant == p2_variant %}selected{% endif %}
                                {% unless variant.available %}disabled{% endunless %}
                              >
                                Size: {{ variant.title }} {% unless variant.available %}(Sold out){% endunless %}
                              </option>
                            {%- endfor -%}
                          </select>
                        </div>
                      {%- else -%}
                        <input type="hidden" class="sh-fbt-variant-id" data-fbt-index="2" value="{{ p2_variant.id }}">
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>

              <!-- Claim Offer CTA Button (matching reference image) -->
              <button
                type="button"
                class="sh-fbt-claim-btn"
                id="sh-fbt-btn-{{ section.id }}"
              >
                <span class="sh-fbt-claim-label">{{ section.settings.fbt_btn_text | default: 'Claim Offer' }}</span>
                <span class="sh-fbt-claim-dot">•</span>
                <span class="sh-fbt-claim-total" id="sh-fbt-bundle-total-{{ section.id }}">{{ bundle_init_total | money }}</span>
                <span class="sh-fbt-claim-compare" id="sh-fbt-bundle-compare-{{ section.id }}"{% unless bundle_init_comp > bundle_init_total %} style="display: none;"{% endunless %}>{{ bundle_init_comp | money }}</span>
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{%- comment -%} JSON variants data for instantaneous client-side variant switching {%- endcomment -%}
{%- if product != blank -%}
  <script type="application/json" id="sh-variants-data-{{ section.id }}">
    {{ product.variants | json }}
  </script>
{%- endif -%}

<style>
  #sh-editorial-{{ section.id }} {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    width: 100%;
    position: relative;
    color: {{ section.settings.text_color | default: '#121212' }};
  }

  #sh-editorial-{{ section.id }} .sh-editorial-container {
    max-width: {{ section.settings.max_width | default: 1440 }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Breadcrumbs Navigation */
  #sh-editorial-{{ section.id }} .sh-breadcrumbs {
    margin: 0 0 24px 0;
    padding: 0;
    width: 100%;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs--right-col {
    margin: 0 0 16px 0;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body-family);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #888888;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__link {
    color: #666666;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__link:hover {
    color: #121212;
    text-decoration: underline;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__separator {
    color: #bbbbbb;
    user-select: none;
    font-size: 11px;
    margin: 0 1px;
  }

  #sh-editorial-{{ section.id }} .sh-breadcrumbs__current {
    color: #121212;
    font-weight: 600;
    max-width: 420px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
  }

  /* 3-Column Editorial Grid */
  #sh-editorial-{{ section.id }} .sh-editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(25rem, 32rem);
    column-gap: 2.4rem;
    align-items: start;
  }

  /* LEFT COLUMN */
  #sh-editorial-{{ section.id }} .sh-editorial-col--left {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
  }

  /* Thumbnails Carousel */
  #sh-editorial-{{ section.id }} .sh-editorial-carousel-wrapper {
    width: 100%;
    position: relative;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumbs-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    padding-bottom: 4px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumbs-track::-webkit-scrollbar {
    display: none; /* Chrome */
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumb-slide {
    flex: 0 0 100%;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumb-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f7f7f7;
    overflow: hidden;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumb-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumb-slide:hover .sh-editorial-thumb-inner img {
    transform: scale(1.04);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-thumb-slide.is-active .sh-editorial-thumb-inner {
    outline: 1.5px solid #121212;
    outline-offset: -1px;
  }

  /* Carousel Navigation Arrows */
  #sh-editorial-{{ section.id }} .sh-editorial-carousel-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    margin-top: 14px;
    padding-right: 4px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-nav-btn {
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #121212;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-nav-btn:hover {
    opacity: 0.6;
    transform: scale(1.1);
  }

  /* Accordions / Collapsible Info */
  #sh-editorial-{{ section.id }} .sh-editorial-accordions {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-summary::-webkit-details-marker {
    display: none;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: calc(var(--font-heading-scale) * 1.6rem);
    font-weight: var(--font-heading-weight, 700);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #121212;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-chevron {
    transition: transform 0.25s ease;
    display: flex;
    align-items: center;
    color: #121212;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-item[open] .sh-editorial-accordion-chevron {
    transform: rotate(180deg);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-body {
    padding-bottom: 22px;
    font-size: 14px;
    line-height: 1.6;
    color: #333333;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-accordion-body p {
    margin: 0 0 10px 0;
  }

  /* CENTER COLUMN: Hero Portrait Image */
  #sh-editorial-{{ section.id }} .sh-editorial-col--center {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-hero-media {
    width: 100%;
    position: relative;
    background: #f7f7f7;
    overflow: hidden;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-main-img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: opacity 0.25s ease;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-hero-placeholder {
    width: 100%;
    aspect-ratio: 2 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eee;
  }

  /* RIGHT COLUMN: Product Title, Variants & Action */
  #sh-editorial-{{ section.id }} .sh-editorial-col--right {
    display: flex;
    flex-direction: column;
    padding-top: 10px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-product-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: calc(var(--font-heading-scale) * 2rem);
    font-weight: var(--font-heading-weight, 700);
    line-height: 1.25;
    letter-spacing: calc(var(--font-heading-scale) * 0.04rem);
    text-transform: none;
    color: #121212;
    margin: 0 0 16px 0;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-price-container {
    font-size: 1.5rem;
    font-weight: 500;
    color: #121212;
    margin-bottom: 2.4rem;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-price-container .price {
    font-size: 20px !important;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-options-wrapper {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 36px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity {
    align-items: center;
    display: flex;
    gap: 1.2rem;
    justify-content: space-between;
    margin: 0 0 1.6rem;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity label {
    font-size: 1.1rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity-control {
    align-items: center;
    border: .1rem solid rgba(18, 18, 18, .45);
    display: flex;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity-button {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-size: 1.8rem;
    height: 3.4rem;
    width: 3.4rem;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity input {
    appearance: textfield;
    border: 0;
    font: inherit;
    height: 3.4rem;
    padding: 0;
    text-align: center;
    width: 3.6rem;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-quantity input::-webkit-inner-spin-button,
  #sh-editorial-{{ section.id }} .sh-editorial-quantity input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-fulfilment {
    border-bottom: .1rem solid rgba(18, 18, 18, .12);
    border-top: .1rem solid rgba(18, 18, 18, .12);
    font-size: 1.1rem;
    margin: 2.4rem 0;
    padding: 1.4rem 0;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-fulfilment p {
    display: flex;
    justify-content: space-between;
    margin: .5rem 0;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-option-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-option-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-option-name {
    color: #121212;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-option-divider {
    color: #888888;
    font-weight: 300;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-option-selected {
    color: #666666;
    font-weight: 400;
  }

  /* Color Swatches (Square) */
  #sh-editorial-{{ section.id }} .sh-editorial-swatch-list {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-color-swatch {
    width: 38px;
    height: 38px;
    padding: 3px;
    background: #ffffff;
    border: 1px solid #121212;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-color-swatch:hover {
    transform: scale(1.08);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-color-swatch.is-active {
    outline: 2px solid #121212;
    outline-offset: 1px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-swatch-color {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Size Boxes (Square buttons) */
  #sh-editorial-{{ section.id }} .sh-editorial-size-list {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-size-box {
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    background: #ffffff;
    color: #121212;
    border: 1px solid #121212;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
    font-family: inherit;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-size-box:hover {
    background-color: #f2f2f2;
    transform: translateY(-1px);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-size-box.is-active {
    background-color: #121212 !important;
    color: #ffffff !important;
  }

  /* Dual Action Buttons: Buy Product & Add To Cart */
  #sh-editorial-{{ section.id }} .sh-editorial-actions {
    display: flex;
    gap: 14px;
    width: 100%;
    margin-top: 10px;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-btn {
    flex: 1;
    height: 52px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    text-align: center;
  }

  /* Buy Product: Solid Black */
  #sh-editorial-{{ section.id }} .sh-editorial-btn--buy {
    background-color: #000000;
    color: #ffffff;
    border: 1.5px solid #000000;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-btn--buy:hover:not([disabled]) {
    background-color: #2b2b2b;
    border-color: #2b2b2b;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }

  /* Add to Cart: White with black border */
  #sh-editorial-{{ section.id }} .sh-editorial-btn--cart {
    background-color: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
  }

  #sh-editorial-{{ section.id }} .sh-editorial-btn--cart:hover:not([disabled]) {
    background-color: #000000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }

  #sh-editorial-{{ section.id }} .sh-editorial-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
    background-color: #e5e5e5 !important;
    border-color: #e5e5e5 !important;
    color: #888888 !important;
  }

  /* ================= RESPONSIVE ================= */
  @media screen and (max-width: 1100px) {
    #sh-editorial-{{ section.id }} .sh-editorial-grid {
      column-gap: 30px;
    }
    #sh-editorial-{{ section.id }} .sh-editorial-product-title {
      font-size: calc(var(--font-heading-scale) * 2.4rem);
    }
    #sh-editorial-{{ section.id }} .sh-editorial-thumb-slide {
      flex: 0 0 calc(50% - 6px);
    }
  }

  @media screen and (max-width: 990px) {
    #sh-editorial-{{ section.id }} {
      padding-top: 40px;
      padding-bottom: 60px;
    }

    #sh-editorial-{{ section.id }} .sh-editorial-container {
      padding: 0 20px;
    }

    #sh-editorial-{{ section.id }} .sh-breadcrumbs {
      margin-bottom: 16px;
    }

    #sh-editorial-{{ section.id }} .sh-breadcrumbs__list {
      font-size: 11px;
      gap: 6px;
    }

    #sh-editorial-{{ section.id }} .sh-breadcrumbs__current {
      max-width: 220px;
    }

    /* Stack on tablet & mobile: Hero Center -> Right Info -> Left Carousel & Accordions */
    #sh-editorial-{{ section.id }} .sh-editorial-grid {
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    #sh-editorial-{{ section.id }} .sh-editorial-col--center {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      order: 1;
      width: 100%;
      max-width: 540px;
      margin: 0 auto;
    }

    #sh-editorial-{{ section.id }} .sh-mobile-only-thumbnails {
      display: block !important;
      width: 100%;
      margin-top: 14px;
    }

    #sh-editorial-{{ section.id }} .sh-desktop-only-thumbnails {
      display: none !important;
    }

    #sh-editorial-{{ section.id }} .sh-editorial-col--right {
      order: 2;
      width: 100%;
    }

    #sh-editorial-{{ section.id }} .sh-editorial-col--left {
      order: 3;
      width: 100%;
      gap: 30px;
    }

    #sh-editorial-{{ section.id }} .sh-editorial-product-title {
