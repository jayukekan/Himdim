</style>

<script>
  (function() {
    function initEditorialProduct() {
      const sectionEl = document.getElementById('sh-editorial-{{ section.id }}');
      if (!sectionEl) return;

      const sizeChartDialog = sectionEl.querySelector('#sh-size-chart-dialog-{{ section.id }}');
      sectionEl.querySelectorAll('.sh-size-chart-trigger').forEach(button => {
        button.addEventListener('click', function() {
          if (sizeChartDialog && typeof sizeChartDialog.showModal === 'function') {
            sizeChartDialog.showModal();
          }
        });
      });
      if (sizeChartDialog) {
        const closeButton = sizeChartDialog.querySelector('.sh-size-chart-dialog__close');
        if (closeButton) {
          closeButton.addEventListener('click', function() {
            sizeChartDialog.close();
          });
        }
      }

      const track = sectionEl.querySelector('#sh-gal-track-{{ section.id }}');
      const prevBtn = sectionEl.querySelector('#sh-gal-prev-{{ section.id }}');
      const nextBtn = sectionEl.querySelector('#sh-gal-next-{{ section.id }}');
      const slides = sectionEl.querySelectorAll('.sh-editorial-gallery-slide');
      const dots = sectionEl.querySelectorAll('.sh-gallery-dot');
      const thumbBtns = sectionEl.querySelectorAll('.sh-gallery-thumb-item');
      const counterCurrent = sectionEl.querySelector('#sh-gal-current-{{ section.id }}');

      // Lightbox Elements
      const lightbox = sectionEl.querySelector('#sh-lightbox-{{ section.id }}');
      const lightboxImg = sectionEl.querySelector('#sh-lightbox-img-{{ section.id }}');
      const lbClose = sectionEl.querySelector('#sh-lb-close-{{ section.id }}');
      const lbPrev = sectionEl.querySelector('#sh-lb-prev-{{ section.id }}');
      const lbNext = sectionEl.querySelector('#sh-lb-next-{{ section.id }}');
      let currentLightboxIndex = 0;

      // Update Active Thumbnail & Counter
      function updateActiveState(index) {
        if (counterCurrent) counterCurrent.textContent = index + 1;

        thumbBtns.forEach((tb, i) => {
          if (i === index) {
            tb.classList.add('is-active');
            tb.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
          } else {
            tb.classList.remove('is-active');
          }
        });

        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });
      }

      // Scroll Gallery to a specific slide index
      function scrollToSlide(index) {
        if (!slides[index] || !track) return;
        track.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
        updateActiveState(index);
      }

      // Gallery Slider Controls
      if (track && prevBtn && nextBtn && slides.length > 0) {
        function getSlideScrollAmount() {
          const firstSlide = slides[0];
          return firstSlide ? firstSlide.offsetWidth + 16 : track.clientWidth / 2;
        }

        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -getSlideScrollAmount(), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: getSlideScrollAmount(), behavior: 'smooth' });
        });

        // Update active thumbnail & counter on scroll
        let scrollTimeout;
        track.addEventListener('scroll', function() {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const scrollLeft = track.scrollLeft;
            let closestIdx = 0;
            let minDiff = Infinity;

            slides.forEach((slide, i) => {
              const diff = Math.abs(slide.offsetLeft - scrollLeft);
              if (diff < minDiff) {
                minDiff = diff;
                closestIdx = i;
              }
            });

            updateActiveState(closestIdx);
          }, 80);
        }, { passive: true });
      }

      // Thumbnail Click Handler
      thumbBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const idx = parseInt(this.getAttribute('data-index'), 10) || 0;
          scrollToSlide(idx);
        });
      });

      // Lightbox / Zoom Logic
      function openLightbox(index) {
        if (!lightbox || !lightboxImg || !slides[index]) return;
        currentLightboxIndex = index;
        const highresUrl = slides[index].getAttribute('data-highres-url') || (slides[index].querySelector('img') ? slides[index].querySelector('img').src : '');
        lightboxImg.src = highresUrl;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (lightbox) {
        slides.forEach((slide, i) => {
          const inner = slide.querySelector('.sh-editorial-slide-inner');
          if (inner) {
            inner.addEventListener('click', function(e) {
              // Only open lightbox if not clicking video controls
              if (e.target.tagName !== 'VIDEO') {
                openLightbox(i);
              }
            });
          }
        });

        if (lbClose) lbClose.addEventListener('click', closeLightbox);
        const backdrop = lightbox.querySelector('.sh-lightbox-backdrop');
        if (backdrop) backdrop.addEventListener('click', closeLightbox);

        if (lbPrev) {
          lbPrev.addEventListener('click', function(e) {
            e.stopPropagation();
            const prevIdx = (currentLightboxIndex - 1 + slides.length) % slides.length;
            openLightbox(prevIdx);
          });
        }

        if (lbNext) {
          lbNext.addEventListener('click', function(e) {
            e.stopPropagation();
            const nextIdx = (currentLightboxIndex + 1) % slides.length;
            openLightbox(nextIdx);
          });
        }

        document.addEventListener('keydown', function(e) {
          if (!lightbox.classList.contains('is-open')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft' && lbPrev) lbPrev.click();
          if (e.key === 'ArrowRight' && lbNext) lbNext.click();
        });
      }

      // Quantity controls
      const quantityInput = sectionEl.querySelector('#sh-quantity-{{ section.id }}');
      sectionEl.querySelectorAll('[data-quantity-action]').forEach(btn => {
        btn.addEventListener('click', function() {
          if (!quantityInput) return;
          const currentVal = Math.max(1, parseInt(quantityInput.value, 10) || 1);
          if (this.getAttribute('data-quantity-action') === 'increase') {
            quantityInput.value = currentVal + 1;
          } else {
            quantityInput.value = Math.max(1, currentVal - 1);
          }
        });
      });

      // Variants Data & Switching
      const variantsDataEl = sectionEl.querySelector('#sh-variants-data-{{ section.id }}');
      let variantsData = [];
      if (variantsDataEl) {
        try {
          variantsData = JSON.parse(variantsDataEl.textContent);
        } catch (e) {
          console.error('Error parsing variants data', e);
        }
      }

      const variantInput = sectionEl.querySelector('#sh-variant-id-{{ section.id }}');
      const selects = sectionEl.querySelectorAll('.sh-editorial-select');
      const patternBtns = sectionEl.querySelectorAll('.sh-pattern-swatch-btn');
      const priceContainer = sectionEl.querySelector('#sh-price-{{ section.id }}');
      const buyBtn = sectionEl.querySelector('#sh-buy-btn-{{ section.id }}');

      function formatMoney(cents) {
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(cents);
        }
        return 'Rs. ' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 });
      }

      function getSelectedOptions() {
        const selected = [];
        selects.forEach(select => {
          selected.push(select.value);
        });
        return selected;
      }

      function updateVariant() {
        if (!variantsData.length) return;
        const selected = getSelectedOptions();

        const matchedVariant = variantsData.find(v => {
          return selected.every((val, idx) => v.options[idx] === val);
        });

        if (matchedVariant) {
          if (variantInput) variantInput.value = matchedVariant.id;

          // Update URL
          if (window.location.pathname.includes('/products/')) {
            const url = new URL(window.location.href);
            url.searchParams.set('variant', matchedVariant.id);
            window.history.replaceState({}, '', url.toString());
          }

          // Update Price
          if (priceContainer) {
            let priceHtml = '';
            if (matchedVariant.compare_at_price > matchedVariant.price) {
              const salePercent = Math.round(((matchedVariant.compare_at_price - matchedVariant.price) / matchedVariant.compare_at_price) * 100);
              priceHtml += '<span class="sh-price-compare">' + formatMoney(matchedVariant.compare_at_price) + '</span>';
              priceHtml += '<span class="sh-price-regular">' + formatMoney(matchedVariant.price) + '</span>';
              priceHtml += '<span class="sh-price-sale-badge">' + salePercent + '% OFF</span>';
            } else {
              priceHtml += '<span class="sh-price-regular">' + formatMoney(matchedVariant.price) + '</span>';
            }
            priceContainer.innerHTML = priceHtml;
          }

          // Update Button State
          if (buyBtn) {
            if (matchedVariant.available) {
              buyBtn.removeAttribute('disabled');
              buyBtn.textContent = '{{ section.settings.buy_now_label | default: "Buy Now" }}';
            } else {
              buyBtn.setAttribute('disabled', 'true');
              buyBtn.textContent = 'Sold Out';
            }
          }

          // Scroll Gallery to Variant Image
          if (matchedVariant.featured_media && matchedVariant.featured_media.id && track) {
            const targetSlide = track.querySelector(`.sh-editorial-gallery-slide[data-media-id="${matchedVariant.featured_media.id}"]`);
            if (targetSlide) {
              const idx = parseInt(targetSlide.getAttribute('data-index'), 10) || 0;
              scrollToSlide(idx);
            }
          }
        }
      }

      // Handle Select Dropdown changes
      selects.forEach(select => {
        select.addEventListener('change', function() {
          const optIdx = this.getAttribute('data-option-index');
          patternBtns.forEach(btn => {
            if (btn.getAttribute('data-option-index') === optIdx) {
              if (btn.getAttribute('data-option-value') === select.value) {
                btn.classList.add('is-active');
              } else {
                btn.classList.remove('is-active');
              }
            }
          });
          updateVariant();
        });
      });

      // Handle Pattern Swatch clicks
      patternBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const optIdx = this.getAttribute('data-option-index');
          const optVal = this.getAttribute('data-option-value');

          patternBtns.forEach(b => {
            if (b.getAttribute('data-option-index') === optIdx) b.classList.remove('is-active');
          });
          this.classList.add('is-active');

          const matchingSelect = sectionEl.querySelector(`.sh-editorial-select[data-option-index="${optIdx}"]`);
          if (matchingSelect) {
            matchingSelect.value = optVal;
            matchingSelect.dispatchEvent(new Event('change'));
          } else {
            updateVariant();
          }
        });
      });

      // Instant Checkout via Buy Now Button
      if (buyBtn) {
        buyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const varId = variantInput ? variantInput.value : null;
          const qty = quantityInput ? Math.max(1, parseInt(quantityInput.value, 10) || 1) : 1;
          if (!varId) return;

          buyBtn.style.opacity = '0.7';
          buyBtn.textContent = 'Redirecting...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [{ id: parseInt(varId), quantity: qty }]
            })
          })
          .then(res => res.json())
          .then(() => {
            window.location.href = '/checkout';
          })
          .catch(err => {
            console.error('Checkout error', err);
            window.location.href = '/cart/' + varId + ':' + qty;
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEditorialProduct);
    } else {
      initEditorialProduct();
    }
    document.addEventListener('shopify:section:load', initEditorialProduct);
  })();
</script>

