{%- comment -%}
  Editorial Luxury Product Showcase (2-Up Responsive Gallery & Minimalist Card)
  Inspired by high-end luxury fashion e-commerce (Burberry, The Row, Celine).
  Features:
  - Left: 2-up responsive image slider on desktop with circular navigation arrows (< >), 1-up swipeable on mobile
  - Right: Minimalist luxury card with serif title, inline price, clean option dropdowns/swatches,
           pill quantity + olive green pill Buy Now button, dotted dividers, shipping/packaging props,
           collapsible accordions with (+) circular icons, and contact link.
  - Fully responsive, accessible, and Online Store 2.0 theme editor compatible.
{%- endcomment -%}

{%- liquid
  if template.name == 'product'
    assign editorial_product = product
  else
    assign editorial_product = section.settings.product | default: product | default: all_products.first
  endif
  assign product = editorial_product

  assign current_variant = product.selected_or_first_available_variant
-%}

<div
  id="sh-editorial-{{ section.id }}"
  class="sh-editorial-product-section"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="sh-editorial-container">
    {%- if section.settings.show_breadcrumbs and section.settings.breadcrumb_position != 'right_col' -%}
      {% render 'breadcrumb', extra_classes: 'sh-breadcrumbs--top', product: product, collection: collection %}
    {%- endif -%}

    <div class="sh-editorial-main-grid">

      <!-- ================= LEFT: 2-UP GALLERY ================= -->
      <div class="sh-editorial-gallery-col">
        <div class="sh-editorial-gallery-wrapper" id="sh-gallery-wrap-{{ section.id }}">
          
          <!-- Prev Button (<) -->
          <button
            type="button"
            class="sh-gallery-arrow sh-gallery-arrow--prev"
            id="sh-gal-prev-{{ section.id }}"
            aria-label="Previous image"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <!-- Slider Track: 2 images visible side-by-side on desktop -->
          <div class="sh-editorial-gallery-track" id="sh-gal-track-{{ section.id }}">
            {%- if product != blank and product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div
                  class="sh-editorial-gallery-slide{% if media.id == current_variant.featured_media.id %} is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                  data-index="{{ forloop.index0 }}"
                >
                  <div class="sh-editorial-slide-inner">
                    {%- if media.media_type == 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1000 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
                        width="800"
                        height="1066"
                        class="sh-editorial-slide-img"
                      >
                    {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                      {{ media | media_tag: image_size: '1000x', autoplay: true, loop: true, controls: false, preload: 'none', class: 'sh-editorial-slide-video' }}
                    {%- else -%}
                      {{ media | media_tag: image_size: '1000x', class: 'sh-editorial-slide-img' }}
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Placeholders (2 images preview) -->
              {%- for i in (1..3) -%}
                <div class="sh-editorial-gallery-slide" data-index="{{ forloop.index0 }}">
                  <div class="sh-editorial-slide-inner placeholder">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <!-- Next Button (>) -->
          <button
            type="button"
            class="sh-gallery-arrow sh-gallery-arrow--next"
            id="sh-gal-next-{{ section.id }}"
            aria-label="Next image"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          <!-- Mobile Dots Navigation -->
          <div class="sh-gallery-dots" id="sh-gal-dots-{{ section.id }}">
            {%- assign media_count = product.media.size | default: 3 -%}
            {%- for i in (1..media_count) -%}
              <span class="sh-gallery-dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          </div>

        </div>
      </div>

      <!-- ================= RIGHT: PRODUCT DETAILS CARD ================= -->
      <div class="sh-editorial-info-col">
        <div class="sh-editorial-card" id="sh-card-{{ section.id }}">

          {%- if section.settings.show_breadcrumbs and section.settings.breadcrumb_position == 'right_col' -%}
            {% render 'breadcrumb', extra_classes: 'sh-breadcrumbs--right-col', product: product, collection: collection %}
          {%- endif -%}

          <!-- Header Row: Title & Price -->
          <div class="sh-editorial-card-header">
            <h1 class="sh-editorial-title">
              {%- if product != blank -%}
                {{ product.title }}
              {%- else -%}
                Seasonal Layers
              {%- endif -%}
            </h1>

            <div class="sh-editorial-price" id="sh-price-{{ section.id }}">
              {%- if product != blank -%}
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  <span class="sh-price-compare">{{ current_variant.compare_at_price | money }}</span>
                {%- endif -%}
                <span class="sh-price-regular">{{ current_variant.price | money }}</span>
              {%- else -%}
                <span class="sh-price-regular">$86.99</span>
              {%- endif -%}
            </div>
          </div>

          <!-- Product Options Form -->
          {%- assign product_form_id = 'sh-product-form-' | append: section.id -%}
          {%- form 'product', product, id: product_form_id, class: 'sh-editorial-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id | default: product.variants.first.id }}" id="sh-variant-id-{{ section.id }}">

            {%- if product != blank and product.has_only_default_variant == false -%}
              <div class="sh-editorial-options-list">
                {%- for option in product.options_with_values -%}
                  {%- assign opt_idx = forloop.index0 -%}
                  {%- assign opt_name_down = option.name | downcase -%}

                  <div class="sh-editorial-option-row" data-option-index="{{ opt_idx }}">
                    <label class="sh-editorial-option-label" for="sh-opt-select-{{ section.id }}-{{ opt_idx }}">
                      {{ option.name }}{% unless option.name contains ':' %}:{% endunless %}
                    </label>

                    <div class="sh-editorial-option-control">
                      {%- if opt_name_down contains 'pattern' and option.values.size > 0 -%}
                        <!-- Pattern Swatch / Dropdown -->
                        <div class="sh-pattern-swatches">
                          {%- for value in option.values -%}
                            {%- assign is_selected = false -%}
                            {%- if option.selected_value == value -%}
                              {%- assign is_selected = true -%}
                            {%- endif -%}
                            <button
                              type="button"
                              class="sh-pattern-swatch-btn{% if is_selected %} is-active{% endif %}"
                              data-option-index="{{ opt_idx }}"
                              data-option-value="{{ value | escape }}"
                              title="{{ value | escape }}"
                              aria-label="{{ value | escape }}"
                            >
                              {%- assign pattern_variant = product.variants | where: option.name, value | first -%}
                              {%- if pattern_variant.featured_image != blank -%}
                                <img src="{{ pattern_variant.featured_image | image_url: width: 80 }}" alt="{{ value | escape }}" width="36" height="24">
                              {%- else -%}
                                <span class="sh-pattern-placeholder"></span>
                              {%- endif -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      <!-- Luxury Select Dropdown with custom caret (Matches "Archive Beige ▾" & "42 ▾") -->
                      <div class="sh-custom-select-wrap">
                        <select
                          id="sh-opt-select-{{ section.id }}-{{ opt_idx }}"
                          class="sh-editorial-select"
                          data-option-index="{{ opt_idx }}"
                          aria-label="{{ option.name }}"
                        >
                          {%- for value in option.values -%}
                            <option
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}selected="selected"{% endif %}
                            >
                              {{ value }}
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="sh-select-caret" aria-hidden="true">
                          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 1 5 5 9 1"></polyline>
                          </svg>
                        </span>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- elsif product == blank -%}
              <!-- Preview Demo Options -->
              <div class="sh-editorial-options-list">
                <div class="sh-editorial-option-row">
                  <span class="sh-editorial-option-label">Pattern:</span>
                  <div class="sh-pattern-swatches">
                    <span class="sh-pattern-placeholder is-active"></span>
                  </div>
                </div>
                <div class="sh-editorial-option-row">
                  <span class="sh-editorial-option-label">Colors:</span>
                  <div class="sh-custom-select-wrap">
                    <select class="sh-editorial-select">
                      <option selected>Archive Beige</option>
                      <option>Classic Black</option>
                      <option>Pure White</option>
                    </select>
                    <span class="sh-select-caret">
                      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="1 1 5 5 9 1"></polyline></svg>
                    </span>
                  </div>
                </div>
                <div class="sh-editorial-option-row">
                  <span class="sh-editorial-option-label">Select Size:</span>
                  <div class="sh-custom-select-wrap">
                    <select class="sh-editorial-select">
                      <option selected>42</option>
                      <option>40</option>
                      <option>44</option>
                    </select>
                    <span class="sh-select-caret">
                      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="1 1 5 5 9 1"></polyline></svg>
                    </span>
                  </div>
                </div>
              </div>
            {%- endif -%}

            <!-- Actions Row: Pill Quantity & Olive Pill Buy Now Button -->
            <div class="sh-editorial-actions-row">
              <div class="sh-editorial-quantity-pill">
                <button
                  type="button"
                  class="sh-qty-btn sh-qty-decrease"
                  data-quantity-action="decrease"
                  aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9"></circle>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                  </svg>
                </button>
                <input
                  id="sh-quantity-{{ section.id }}"
                  name="quantity"
                  type="number"
                  min="1"
                  value="1"
                  class="sh-qty-input"
                  aria-label="{{ 'products.product.quantity.label' | t }}"
                >
                <button
                  type="button"
                  class="sh-qty-btn sh-qty-increase"
                  data-quantity-action="increase"
                  aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9"></circle>
                    <line x1="12" y1="8" x2="12" y2="16"></line>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                  </svg>
                </button>
              </div>

              <button
                type="button"
                class="sh-editorial-buy-now-btn"
                id="sh-buy-btn-{{ section.id }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available or product == blank -%}
                  {{ section.settings.buy_now_label | default: 'Buy Now' }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          {%- endform -%}

          <!-- Dotted Separator -->
          <div class="sh-editorial-dotted-divider" aria-hidden="true"></div>

          <!-- Value Props: Delivery & Packaging -->
          {%- if section.settings.show_value_props -%}
            <div class="sh-editorial-value-props">
              <div class="sh-value-prop-row">
                <span class="sh-prop-label">{{ section.settings.delivery_text_left | default: 'Free Delivery & Returns' }}</span>
                <span class="sh-prop-value">{{ section.settings.delivery_text_right | default: 'Available on all orders' }}</span>
              </div>
              <div class="sh-value-prop-row">
                <span class="sh-prop-label">{{ section.settings.packaging_text_left | default: 'Gift Packaging' }}</span>
                <span class="sh-prop-value">{{ section.settings.packaging_text_right | default: 'Complimentary and plastic-free' }}</span>
              </div>
            </div>

            <!-- Dotted Separator -->
            <div class="sh-editorial-dotted-divider" aria-hidden="true"></div>
          {%- endif -%}

          <!-- Accordions: Collapsible Tabs with (+) Circular Icons -->
          <div class="sh-editorial-accordions">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <details class="sh-editorial-accordion-item"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="sh-editorial-accordion-summary">
                    <span class="sh-editorial-accordion-title">{{ block.settings.title | escape }}</span>
                    <span class="sh-editorial-accordion-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line class="sh-icon-v-line" x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                      </svg>
                    </span>
                  </summary>
                  <div class="sh-editorial-accordion-body rte">
                    {%- if block.type == 'description' -%}
                      {%- if product != blank and product.description != blank -%}
                        {{ product.description }}
                      {%- else -%}
                        <p>{{ block.settings.content | default: 'Wide leg pants in technical fabric. Elasticated waist band with side slit pockets and drawstring on hem.' }}</p>
                      {%- endif -%}
                    {%- else -%}
                      {{ block.settings.content }}
                    {%- endif -%}
                  </div>
                </details>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Default Accordions -->
              <details class="sh-editorial-accordion-item">
                <summary class="sh-editorial-accordion-summary">
                  <span class="sh-editorial-accordion-title">Product Details</span>
                  <span class="sh-editorial-accordion-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"></circle><line class="sh-icon-v-line" x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                  </span>
                </summary>
                <div class="sh-editorial-accordion-body rte">
                  {%- if product != blank and product.description != blank -%}
                    {{ product.description }}
                  {%- else -%}
                    <p>Standard fit with lightweight cotton blend fabric, crafted for breathability and effortless daily wear.</p>
                  {%- endif -%}
                </div>
              </details>
              <details class="sh-editorial-accordion-item">
                <summary class="sh-editorial-accordion-summary">
                  <span class="sh-editorial-accordion-title">Fabric & Care</span>
                  <span class="sh-editorial-accordion-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"></circle><line class="sh-icon-v-line" x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                  </span>
                </summary>
                <div class="sh-editorial-accordion-body rte">
                  <p>100% Organic Cotton. Machine wash cold with like colors. Do not bleach. Lay flat to dry.</p>
                </div>
              </details>
            {%- endif -%}
          </div>

          <!-- Contact Us Link -->
          {%- if section.settings.show_contact_link -%}
            <div class="sh-editorial-card-footer">
              <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="sh-editorial-contact-link">
                {{ section.settings.contact_text | default: 'Contact Us' }}
              </a>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>

    <!-- ================= FREQUENTLY BOUGHT TOGETHER ================= -->
    {%- if section.settings.show_fbt -%}
      {%- liquid
        assign fbt_prod_1 = blank
        assign fbt_prod_2 = blank

        if section.settings.fbt_products != blank and section.settings.fbt_products.count > 0
          for bp in section.settings.fbt_products
            if bp.id != product.id and bp.available
              if fbt_prod_1 == blank
                assign fbt_prod_1 = bp
              elsif fbt_prod_2 == blank
                assign fbt_prod_2 = bp
                break
              endif
            endif
          endfor
        endif

        if fbt_prod_1 == blank and product != blank
          assign target_coll = product.collections.first
          if target_coll == blank or target_coll.products_count < 2
            assign target_coll = collections.all
          endif
          for cp in target_coll.products
            if cp.id != product.id and cp.available
              if fbt_prod_1 == blank
                assign fbt_prod_1 = cp
              elsif fbt_prod_2 == blank
                assign fbt_prod_2 = cp
                break
              endif
            endif
          endfor
        endif

        assign has_fbt = false
        if fbt_prod_1 != blank or product == blank
          assign has_fbt = true
        endif
      -%}

      {%- if has_fbt -%}
        {%- liquid
          assign p0_price = current_variant.price | default: 64900
          assign p0_comp = current_variant.compare_at_price | default: p0_price

          if fbt_prod_1 != blank
            assign p1_variant = fbt_prod_1.selected_or_first_available_variant
            assign p1_price = p1_variant.price
            assign p1_comp = p1_variant.compare_at_price | default: p1_price
          else
            assign p1_price = 84900
            assign p1_comp = 84900
          endif

          assign bundle_init_total = p0_price | plus: p1_price
          assign bundle_init_comp = p0_comp | plus: p1_comp

          if fbt_prod_2 != blank
            assign p2_variant = fbt_prod_2.selected_or_first_available_variant
            assign p2_price = p2_variant.price
            assign p2_comp = p2_variant.compare_at_price | default: p2_price
            assign bundle_init_total = bundle_init_total | plus: p2_price
            assign bundle_init_comp = bundle_init_comp | plus: p2_comp
          endif
        -%}

        <div class="sh-fbt-wrapper" id="sh-fbt-{{ section.id }}">
          <h3 class="sh-fbt-heading">{{ section.settings.fbt_heading | default: 'Frequently bought together' }}</h3>

          <div class="sh-fbt-cards-list">
            <!-- Card 0: Current Product -->
            <div class="sh-fbt-card is-active" data-fbt-card="0">
              <div class="sh-fbt-card-check">
                <label class="sh-fbt-custom-check">
                  <input
                    type="checkbox"
                    class="sh-fbt-checkbox"
                    checked
                    disabled
                    data-fbt-index="0"
                    data-price="{{ p0_price }}"
                    data-compare-at="{{ p0_comp }}"
                  >
                  <span class="sh-fbt-check-box">
                    <svg viewBox="0 0 14 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="1.5 5.5 5 9 12.5 1.5"></polyline>
                    </svg>
                  </span>
                </label>
              </div>

              <div class="sh-fbt-card-media">
                {%- assign fbt_img_0 = current_variant.featured_image | default: product.featured_image -%}
                {%- if fbt_img_0 != blank -%}
                  <img
                    id="sh-fbt-thumb-0-{{ section.id }}"
                    src="{{ fbt_img_0 | image_url: width: 200 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    width="64"
                    height="64"
                  >
                {%- else -%}
                  <div class="sh-fbt-placeholder-img">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              <div class="sh-fbt-card-content">
                <div class="sh-fbt-card-title">{{ product.title | default: 'Current Product' }}</div>
                <div class="sh-fbt-card-pricing">
                  <span class="sh-fbt-card-price" id="sh-fbt-price-0-{{ section.id }}">{{ p0_price | money }}</span>
                  {%- if p0_comp > p0_price -%}
                    <span class="sh-fbt-card-compare" id="sh-fbt-compare-0-{{ section.id }}">{{ p0_comp | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- Card 1: Complementary Product 1 -->
            <div class="sh-fbt-card is-active" data-fbt-card="1">
              <div class="sh-fbt-card-check">
                <label class="sh-fbt-custom-check">
                  <input
                    type="checkbox"
                    class="sh-fbt-checkbox sh-fbt-toggle"
                    checked
                    data-fbt-index="1"
                    data-price="{{ p1_price }}"
                    data-compare-at="{{ p1_comp }}"
                  >
                  <span class="sh-fbt-check-box">
                    <svg viewBox="0 0 14 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="1.5 5.5 5 9 12.5 1.5"></polyline>
                    </svg>
                  </span>
                </label>
              </div>

              <div class="sh-fbt-card-media">
                {%- if fbt_prod_1 != blank and fbt_prod_1.featured_image != blank -%}
                  <img
                    id="sh-fbt-thumb-1-{{ section.id }}"
                    src="{{ fbt_prod_1.featured_image | image_url: width: 200 }}"
                    alt="{{ fbt_prod_1.title | escape }}"
                    loading="lazy"
                    width="64"
                    height="64"
                  >
                {%- else -%}
                  <div class="sh-fbt-placeholder-img">
                    {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              <div class="sh-fbt-card-content">
                {%- if fbt_prod_1 != blank -%}
                  <a href="{{ fbt_prod_1.url }}" target="_blank" class="sh-fbt-card-title">{{ fbt_prod_1.title }}</a>
                {%- else -%}
                  <span class="sh-fbt-card-title">Complementary Fashion Piece</span>
                {%- endif -%}
                <div class="sh-fbt-card-pricing">
                  <span class="sh-fbt-card-price" id="sh-fbt-price-1-{{ section.id }}">{{ p1_price | money }}</span>
                  {%- if p1_comp > p1_price -%}
                    <span class="sh-fbt-card-compare" id="sh-fbt-compare-1-{{ section.id }}">{{ p1_comp | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>

          <button
            type="button"
            class="sh-fbt-claim-btn"
            id="sh-fbt-btn-{{ section.id }}"
          >
            <span class="sh-fbt-claim-label">{{ section.settings.fbt_btn_text | default: 'Claim Offer' }}</span>
            <span class="sh-fbt-claim-dot">•</span>
            <span class="sh-fbt-claim-total" id="sh-fbt-bundle-total-{{ section.id }}">{{ bundle_init_total | money }}</span>
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

