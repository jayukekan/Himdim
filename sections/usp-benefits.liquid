<section
  class="usp-benefits"
  style="--usp-background: {{ section.settings.background_color }}; --usp-foreground: {{ section.settings.text_color }}; --usp-icon: {{ section.settings.icon_color }}; --usp-border: {{ section.settings.border_color }}; --usp-content-width: {{ section.settings.content_width }}px; --usp-padding-top: {{ section.settings.padding_top }}px; --usp-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="usp-benefits__inner">
    <ul class="usp-benefits__list" role="list">
      {%- for block in section.blocks -%}
        {%- capture benefit_content -%}
          <span class="usp-benefits__icon" aria-hidden="true">
            {% render 'icon-accordion', icon: block.settings.icon %}
          </span>
          <span class="usp-benefits__copy">
            <span class="usp-benefits__heading">{{ block.settings.heading | escape }}</span>
            {%- if block.settings.detail != blank -%}
              <span class="usp-benefits__detail">{{ block.settings.detail | escape }}</span>
            {%- endif -%}
          </span>
        {%- endcapture -%}
        <li class="usp-benefits__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="usp-benefits__content" href="{{ block.settings.link }}">{{ benefit_content }}</a>
          {%- else -%}
            <div class="usp-benefits__content">{{ benefit_content }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .usp-benefits {
    background: var(--usp-background);
    border-bottom: 1px solid var(--usp-border);
    border-top: 1px solid var(--usp-border);
    color: var(--usp-foreground);
    padding: var(--usp-padding-top) 2rem var(--usp-padding-bottom);
  }

  #shopify-section-{{ section.id }} .usp-benefits__inner {
    margin: 0 auto;
    max-width: var(--usp-content-width);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .usp-benefits__list {
    align-items: stretch;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .usp-benefits__item {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .usp-benefits__content {
    align-items: center;
    color: inherit;
    display: flex;
    gap: 1rem;
    height: 100%;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .usp-benefits__icon {
    align-items: center;
    color: var(--usp-icon);
    display: inline-flex;
    flex: 0 0 2.4rem;
    height: 2.4rem;
    justify-content: center;
    width: 2.4rem;
  }

  #shopify-section-{{ section.id }} .usp-benefits__icon svg {
    height: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .usp-benefits__copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .usp-benefits__heading {
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .usp-benefits__detail {
    color: inherit;
    font-size: 1.2rem;
    line-height: 1.4;
    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .usp-benefits__content[href]:hover .usp-benefits__heading {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .usp-benefits__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .usp-benefits {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }

    #shopify-section-{{ section.id }} .usp-benefits__list {
      column-gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.8rem;
    }

    #shopify-section-{{ section.id }} .usp-benefits__content {
      gap: 0.8rem;
    }

    #shopify-section-{{ section.id }} .usp-benefits__icon {
      flex-basis: 2rem;
      height: 2rem;
      width: 2rem;
    }

    #shopify-section-{{ section.id }} .usp-benefits__heading {
      font-size: 1.25rem;
    }

    #shopify-section-{{ section.id }} .usp-benefits__detail {
      font-size: 1.1rem;
    }
  }
</style>

{% schema %}
{
  "name": "USP benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#30201b"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#30201b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#e8e3df"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "benefit",
      "name": "USP column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "box", "label": "Shipping box" },
            { "value": "chat_bubble", "label": "Customer support" },
            { "value": "lock", "label": "Secure payment" },
            { "value": "check_mark", "label": "Checkout check" },
            { "value": "stopwatch", "label": "Fast service" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "USP text",
          "default": "Timely Delivery"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Supporting text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "heading": "Timely Delivery" } },
        { "type": "benefit", "settings": { "icon": "box", "heading": "Free Shipping" } },
        { "type": "benefit", "settings": { "icon": "chat_bubble", "heading": "24/7 Support" } },
        { "type": "benefit", "settings": { "icon": "lock", "heading": "Secured Payment" } },
        { "type": "benefit", "settings": { "icon": "check_mark", "heading": "Safe Check Out" } }
      ]
    }
  ]
}
{% endschema %}
