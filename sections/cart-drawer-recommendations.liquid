{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="cart-drawer-recommendations__results">
    {%- for product in recommendations.products limit: 4 -%}
      {%- assign current_var = product.selected_or_first_available_variant -%}
      <div class="cart-drawer-upsell__card" data-product-id="{{ product.id }}">
        <a href="{{ product.url }}" class="cart-drawer-upsell__image-link" tabindex="-1" aria-hidden="true">
          {%- if product.featured_image -%}
            <img
              class="cart-drawer-upsell__image"
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="140"
              height="187"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'cart-drawer-upsell__image placeholder' }}
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            {%- assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="cart-drawer-upsell__badge">{{ discount_percent }}% OFF</span>
          {%- endif -%}
        </a>

        <div class="cart-drawer-upsell__info">
          <a href="{{ product.url }}" class="cart-drawer-upsell__product-title" title="{{ product.title | escape }}">
            {{ product.title | escape }}
          </a>

          <div class="cart-drawer-upsell__pricing">
            <span class="cart-drawer-upsell__price">{{ current_var.price | money }}</span>
            {%- if current_var.compare_at_price > current_var.price -%}
              <s class="cart-drawer-upsell__compare-price">{{ current_var.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          {%- if product.has_only_default_variant == false -%}
            <div class="cart-drawer-upsell__variant-wrap">
              <select
                class="cart-drawer-upsell__variant-select"
                aria-label="Select size for {{ product.title | escape }}"
              >
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant.id == current_var.id %}selected="selected"{% endif %}
                    {% unless variant.available %}disabled="disabled"{% endunless %}
                    data-price="{{ variant.price | money }}"
                    data-compare-price="{{ variant.compare_at_price | money }}"
                    data-available="{% if variant.available %}true{% else %}false{% endif %}"
                  >
                    Size: {{ variant.title | upcase }}{% unless variant.available %} - Sold out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          <button
            type="button"
            class="cart-drawer-upsell__add-btn"
            data-variant-id="{{ current_var.id }}"
            {% unless current_var.available %}disabled="disabled"{% endunless %}
          >
            <span class="cart-drawer-upsell__add-btn-text">
              {%- if current_var.available -%}+ Add{%- else -%}Sold Out{%- endif -%}
            </span>
            <span class="cart-drawer-upsell__spinner" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path></svg>
            </span>
          </button>
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ]
}
{% endschema %}
