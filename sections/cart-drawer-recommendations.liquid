{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="cart-drawer-recommendations__content">
    <h3 class="cart-drawer-recommendations__heading">{{ section.settings.heading | escape }}</h3>
    <ul class="cart-drawer-recommendations__list" role="list">
      {%- for recommendation in recommendations.products limit: 4 -%}
        <li class="cart-drawer-recommendations__item">
          <a class="cart-drawer-recommendations__image" href="{{ recommendation.url }}" aria-label="{{ recommendation.title | escape }}">
            {%- if recommendation.featured_image -%}
              {{ recommendation.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', alt: recommendation.featured_image.alt | default: recommendation.title | escape }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="cart-drawer-recommendations__details">
            <a class="cart-drawer-recommendations__title" href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a>
            <div class="cart-drawer-recommendations__price">
              {%- if recommendation.compare_at_price > recommendation.price -%}
                <span>{{ recommendation.price | money }}</span>
                <s>{{ recommendation.compare_at_price | money }}</s>
              {%- else -%}
                <span>{{ recommendation.price | money }}</span>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <style>
    .cart-drawer-recommendations { display: block; padding: 1.6rem 2rem 0; }
    .cart-drawer-recommendations__heading { margin: 0 0 1.2rem; font-size: 1.5rem; }
    .cart-drawer-recommendations__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
    .cart-drawer-recommendations__item { display: flex; min-width: 0; gap: .9rem; align-items: center; }
    .cart-drawer-recommendations__image { display: block; width: 6rem; flex: 0 0 6rem; overflow: hidden; background: rgba(var(--color-foreground), .04); }
    .cart-drawer-recommendations__image img, .cart-drawer-recommendations__image svg { display: block; width: 100%; height: 7.5rem; object-fit: cover; }
    .cart-drawer-recommendations__details { min-width: 0; }
    .cart-drawer-recommendations__title { display: -webkit-box; overflow: hidden; color: rgb(var(--color-foreground)); font-size: 1.2rem; line-height: 1.35; text-decoration: none; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .cart-drawer-recommendations__price { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .4rem; font-size: 1.2rem; }
    .cart-drawer-recommendations__price s { color: rgba(var(--color-foreground), .6); }
    @media screen and (max-width: 380px) { .cart-drawer-recommendations__list { grid-template-columns: 1fr; } }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Cart recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ]
}
{% endschema %}
