{% doc %}
  Renders the editorial product image viewer.

  @param {object} section - Current section.
  @param {product} product - Current product.

  @example
  {% render 'sh-product-lightbox', section: section, product: product %}
{% enddoc %}

<div
  class="sh-gallery-lightbox"
  id="sh-lightbox-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'products.modal.label' | t | escape }}"
  aria-hidden="true"
  hidden
>
  <div class="sh-lightbox-container" tabindex="-1">
    <div class="sh-lightbox-toolbar">
      <span class="sh-lightbox-counter" aria-hidden="true">
        <span id="sh-lb-current-{{ section.id }}">1</span>
        <span>/</span>
        <span id="sh-lb-total-{{ section.id }}">{{ product.images.size }}</span>
      </span>
      <span class="sh-lightbox-toolbar__title">{{ product.title | escape }}</span>
      <button
        type="button"
        class="sh-lightbox-btn sh-lightbox-close"
        id="sh-lb-close-{{ section.id }}"
        aria-label="{{ 'accessibility.close' | t | escape }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="sh-lightbox-stage" id="sh-lb-stage-{{ section.id }}">
      <button type="button" class="sh-lightbox-btn sh-lightbox-arrow sh-lightbox-prev" id="sh-lb-prev-{{ section.id }}" aria-label="{{ 'sections.slideshow.previous_slideshow' | t | escape }}">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>

      <div class="sh-lightbox-img-wrap">
        <img
          id="sh-lightbox-img-{{ section.id }}"
          alt=""
          class="sh-lightbox-img"
          width="1600"
          height="2400"
          draggable="false"
        >
      </div>

      <button type="button" class="sh-lightbox-btn sh-lightbox-arrow sh-lightbox-next" id="sh-lb-next-{{ section.id }}" aria-label="{{ 'sections.slideshow.next_slideshow' | t | escape }}">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="sh-lightbox-controls" aria-label="Image zoom controls">
      <button type="button" class="sh-lightbox-control" data-lightbox-zoom-action="out" aria-label="Zoom out">&minus;</button>
      <button type="button" class="sh-lightbox-control sh-lightbox-control--reset" data-lightbox-zoom-action="reset" aria-label="{{ 'products.facets.reset' | t | escape }}">
        <span id="sh-lb-zoom-value-{{ section.id }}">100%</span>
      </button>
      <button type="button" class="sh-lightbox-control" data-lightbox-zoom-action="in" aria-label="Zoom in">+</button>
    </div>

    <p class="visually-hidden sh-lightbox-live-region" id="sh-lb-status-{{ section.id }}" aria-live="polite"></p>
  </div>
</div>
